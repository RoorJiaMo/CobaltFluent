<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Cobalt.Fluent.Gallery</RootNamespace>
    <AssemblyName>Cobalt.Fluent.Gallery</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- exe 自身的图标（Windows 资源管理器与任务栏固定项读的是它，不是 Window.Icon）。
         条件判断是必需的：ApplicationIcon 指向不存在的文件会直接导致编译失败，
         而品牌资源不该是编译的硬依赖。 -->
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)/Assets/app.ico')">Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <!-- Linux / 嵌入式上没有 Segoe，Inter 作为 $Default 兜底，中文再由系统字体补 -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cobalt.Fluent/Cobalt.Fluent.csproj" />
  </ItemGroup>

  <!-- 品牌资源。Assets/logo.png 缺席时顶栏自动回落到文字标记，编译不受影响。 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- 「查看源码」的原文。axaml 会被编译成二进制资源，运行时拿不回文本，
       所以把原文再嵌一份进程序集：页面示例 + 控件层 ControlTheme + 控件类。
       LogicalName 里的 %(RecursiveDir) 在 Windows 上出反斜杠，SourceIndex 读的时候统一成 /。 -->
  <ItemGroup>
    <EmbeddedResource Include="Pages/*.axaml" LogicalName="src://pages/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Pages/*.axaml.cs" LogicalName="src://pages/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/Cobalt.Fluent/Themes/**/*.axaml"
                      LogicalName="src://themes/%(RecursiveDir)%(Filename)%(Extension)"
                      Visible="false" />
    <EmbeddedResource Include="../../src/Cobalt.Fluent/Controls/**/*.cs"
                      LogicalName="src://controls/%(RecursiveDir)%(Filename)%(Extension)"
                      Visible="false" />
  </ItemGroup>

</Project>
