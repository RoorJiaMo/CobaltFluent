<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.InfoBadgePage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="InfoBadge" />
      <Border Classes="tag"><TextBlock Text="5 · 反馈" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="默认「浅底 + 状态色文字」，明暗两套主题下对比度都成立。实底变体用于导航计数这类需要强提示的场景，它的前景复用 TextOnAccentFillColorPrimary（浅色主题白 / 深色主题黑），跟着主题翻转——写死白色的话深色主题下会糊在一起。" />

    <TextBlock Classes="sub" Text="浅底（默认）" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <fc:InfoBadge Text="12" />
        <fc:InfoBadge Text="3" Severity="Success" />
        <fc:InfoBadge Text="7" Severity="Caution" />
        <fc:InfoBadge Text="2" Severity="Critical" />
        <fc:InfoBadge Text="—" Severity="Neutral" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="实底" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <fc:InfoBadge Text="12" IsSolid="True" />
        <fc:InfoBadge Text="3" Severity="Success" IsSolid="True" />
        <fc:InfoBadge Text="7" Severity="Caution" IsSolid="True" />
        <fc:InfoBadge Text="2" Severity="Critical" IsSolid="True" />
        <fc:InfoBadge Text="0" Severity="Neutral" IsSolid="True" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="圆点 — 不需要计数时" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <fc:InfoBadge IsDot="True" />
        <fc:InfoBadge IsDot="True" Severity="Success" IsSolid="True" />
        <fc:InfoBadge IsDot="True" Severity="Critical" IsSolid="True" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="典型用法 — 挂在导航项上" />
    <Border Classes="panel">
      <StackPanel Width="240" Spacing="2">
        <Border Padding="12,0" Height="40" CornerRadius="4"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <fc:SymbolIcon Symbol="Warning" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="报警" Margin="16,0,0,0" VerticalAlignment="Center" />
            <fc:InfoBadge Grid.Column="2" Text="3" Severity="Critical" IsSolid="True" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <g:MapBlock Note="状态徽章默认用「浅底 + 状态色文字」，明暗两套都成立。solid 变体的前景复用 TextOnAccentFillColorPrimaryBrush，因为状态色和强调色遵循同一套明暗翻转逻辑。">
      <g:MapRow Key="控件" Value="InfoBadge（本库自定义，Avalonia 本体没有）" />
      <g:MapRow Key="属性" Value="Severity:{Informational,Success,Caution,Critical,Neutral} · Text · IsDot · IsSolid" />
      <g:MapRow Key="伪类" Value=":informational :success :caution :critical :neutral :dot :solid" />
      <g:MapRow Key="资源键" Value="SystemFillColor*Brush 与对应的 *BackgroundBrush · AccentFillColorDefaultBrush" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
