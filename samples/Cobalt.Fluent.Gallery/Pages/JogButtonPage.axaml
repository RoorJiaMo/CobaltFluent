<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.JogButtonPage">

  <StackPanel HorizontalAlignment="Left" MaxWidth="880">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="JogButton" />
      <Border Classes="tag"><TextBlock Text="7 · HMI 专用" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="点动：按住动作，松开停止。视觉上必须区别于普通 Button（描边更重、底边 2px），否则操作员会当成开关按一下就走。:jogging 就是「正在动作」，是本控件唯一有意义的活跃态。" />

    <TextBlock Classes="sub" Text="状态矩阵" />
    <g:SpecMatrix States="rest,pointerover,jogging,disabled,focus">
      <g:SpecMatrix.Sample>
        <DataTemplate><fc:JogButton Content="正转" /></DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>

    <TextBlock Classes="sub" Text="成对 — 相接处不圆、不双线" />
    <Border Classes="panel">
      <StackPanel Spacing="16">
        <fc:JogGroup>
          <fc:JogButton Content="开阀" Direction="Open" />
          <fc:JogButton Content="关阀" Direction="Close" />
        </fc:JogGroup>
        <TextBlock Classes="note" Text="V-201 进料阀 · 当前开度 42%" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="试玩 —— 注意安全行为" />
    <Border Classes="play" HorizontalAlignment="Stretch">
      <StackPanel Spacing="16">
        <fc:JogGroup>
          <fc:JogButton x:Name="Fwd" Content="正转" Direction="Forward" />
          <fc:JogButton x:Name="Rev" Content="反转" Direction="Backward" />
        </fc:JogGroup>
        <TextBlock x:Name="Output" Classes="note" FontFamily="{DynamicResource MonospaceFontFamily}"
                   Text="■ 已停止" />
        <TextBlock Classes="note" MaxWidth="820"
                   Text="按住会一直计时。试试按住后把指针拖出按钮再松开——普通实现在这里会漏掉停止事件，设备一直动；本控件走 PointerCaptureLost / 指针离开两条路都能停。按住不动超过 5 秒会被看门狗强制停止。" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="必须挂满停止触发点才安全：只监听 PointerReleased 不够——按住后把指针拖出按钮，释放事件可能根本不在这个控件上触发。再加一个看门狗定时器兜底，防止 UI 线程卡死时设备失控。StopCommand 会被重复调用（多个触发点可能同时命中），下游必须做成幂等的。">
      <g:MapRow Key="类型" Value="JogButton : Button（容器 JogGroup : StackPanel）" />
      <g:MapRow Key="属性" Value="Direction:enum · StartCommand · StopCommand · Speed · RequiresConfirm=false · WatchdogTimeout=5s" />
      <g:MapRow Key="停止触发点" Value="PointerReleased · PointerCaptureLost · PointerExited · LostFocus · KeyUp · 摘出视觉树 / 被禁用 · 看门狗超时" />
      <g:MapRow Key="伪类" Value=":jogging" />
      <g:MapRow Key="事件" Value="JogStarted · JogStopped(Reason) —— 建议把 Reason 记进操作日志，出事后要靠它复盘" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
