<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             x:Class="Cobalt.Fluent.Gallery.Pages.ListBoxPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="ListBox" />
      <Border Classes="tag"><TextBlock Text="4 · 集合" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="项高 40，圆角 4，项间 2px。选中态不是整行变蓝，而是左侧一条 3×16 的圆角指示条 + 淡底。这是第 2–6 组里唯一必须动 ControlTemplate 的地方——Avalonia 内置的 ListBoxItem 模板没有指示条。" />

    <TextBlock Classes="sub" Text="状态矩阵" />
    <g:SpecMatrix States="rest,pointerover,pressed,selected,disabled">
      <g:SpecMatrix.Sample>
        <DataTemplate><ListBoxItem Content="通道 1 · 温度" Width="200" /></DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>

    <TextBlock Classes="sub" Text="列表" />
    <Border Classes="panel">
      <ListBox Width="260" SelectedIndex="1">
        <ListBoxItem Content="通道 1 · 温度" />
        <ListBoxItem Content="通道 2 · 压力" />
        <ListBoxItem Content="通道 3 · 搅拌" />
        <ListBoxItem Content="通道 4 · pH" />
        <ListBoxItem Content="通道 5 · 流量（未接线）" IsEnabled="False" />
      </ListBox>
    </Border>

    <TextBlock Classes="sub" Text="试玩" />
    <Border Classes="play">
      <StackPanel Spacing="12">
        <ListBox Width="280" Height="200" SelectedIndex="0">
          <ListBoxItem Content="Recipe-041 · PES 标准" />
          <ListBoxItem Content="Recipe-042 · PES 快速" />
          <ListBoxItem Content="Recipe-043 · PVDF 标准" />
          <ListBoxItem Content="Recipe-044 · PVDF 高温" />
          <ListBoxItem Content="Recipe-045 · 测试配方" />
          <ListBoxItem Content="Recipe-046 · 标定专用" />
        </ListBox>
        <TextBlock Classes="note" MaxWidth="700"
                   Text="指示条高度约为行高的 40%，撑满会立刻显得不像 Win11。悬停未选中项看淡底，选中项左侧出现指示条。" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="Avalonia 内置 ListBoxItem 模板没有左侧指示条，需要自定义 ControlTheme：在模板里加一个 Border，Width=3 Height=16 圆角 1.5，绑 :selected 显隐。这是本组唯一必须动 Template 的地方。">
      <g:MapRow Key="控件" Value="ListBox · ListBoxItem" />
      <g:MapRow Key="选择器" Value="ListBoxItem:selected · ListBoxItem:selected:pointerover · ListBoxItem:pressed" />
      <g:MapRow Key="资源键" Value="SubtleFillColorSecondaryBrush（hover / selected 底）· AccentFillColorDefaultBrush（指示条）" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
