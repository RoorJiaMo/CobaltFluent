<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.StepperPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="Stepper / Chip / Toast" />
      <Border Classes="tag"><TextBlock Text="11 · 常用补充" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="最后一组，其中有一条硬性规则：Toast 会自动消失。它仅适用于「操作成功回执」这类可忽略的瞬时消息，报警绝不能使用它——错过的 Toast 无法追回，需要处置的事项由 InfoBar 和 AlarmBanner 承担。" />

    <TextBlock Classes="sub" Text="Stepper — 多步流程" />
    <Border Classes="panel">
      <fc:Stepper CurrentIndex="2" Width="620">
        <fc:StepperItem Content="选择配方" />
        <fc:StepperItem Content="参数校验" />
        <fc:StepperItem Content="通道分配" />
        <fc:StepperItem Content="安全确认" />
        <fc:StepperItem Content="开始运行" />
      </fc:Stepper>
    </Border>
    <TextBlock Classes="note" MaxWidth="700"
               Text="连接线要落在 bullet 的垂直中心（28px 的一半，即 14px），偏差几像素即可被察觉。已完成段的连接线用 accent 色——线属于前一步，表示「该段已完成」。各步等宽，否则线长短不一，视觉上呈现歪斜。" />

    <TextBlock Classes="sub" Text="失败态 — 某步 IsError=True" />
    <Border Classes="panel">
      <fc:Stepper CurrentIndex="2" Width="620">
        <fc:StepperItem Content="选择配方" />
        <fc:StepperItem Content="参数校验" IsError="True" />
        <fc:StepperItem Content="通道分配" />
        <fc:StepperItem Content="安全确认" />
        <fc:StepperItem Content="开始运行" />
      </fc:Stepper>
    </Border>
    <TextBlock Classes="note" MaxWidth="700"
               Text="失败态由该步骤自行声明，优先级高于由 CurrentIndex 推导的结果——流程已推进不等于此前步骤已通过。文字同样变红：仅靠一个 28px 的圆不足以传达「此处发生错误」的信息量。" />

    <TextBlock Classes="sub" Text="StepperItem 状态 — 由 CurrentIndex 推导，无需手动添加类" />
    <g:SpecMatrix States="pending,done,current,error">
      <g:SpecMatrix.Sample>
        <DataTemplate>
          <fc:StepperItem Content="参数校验" StepNumber="2" IsLast="True" />
        </DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>

    <TextBlock Classes="sub" Text="Chip — 可删除的筛选标签" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <fc:Chip Content="配方：PES" />
        <fc:Chip Content="近 7 天" />
        <fc:Chip Content="只读标签" IsClosable="False" />
        <fc:Chip Content="已选 3 项" IsAccent="True" />
      </StackPanel>
    </Border>
    <TextBlock Classes="note" MaxWidth="700"
               Text="高 24 的胶囊。IsClosable 关闭后即纯展示标签，右侧内边距会补齐，否则视觉重心偏左。IsAccent 保留给「当前生效的筛选条件」，一屏内最多一个。" />

    <TextBlock Classes="sub" Text="PersonPicture" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <fc:PersonPicture Size="Small" DisplayName="张" />
        <fc:PersonPicture DisplayName="张辉" />
        <fc:PersonPicture Size="Large" DisplayName="Zhang Hui" />
        <fc:PersonPicture DisplayName="?" IsNeutral="True" />
      </StackPanel>
    </Border>
    <TextBlock Classes="note" MaxWidth="700"
               Text="24 / 32 / 48 三档。中文名取姓氏一字即可，取两字反而不符合称呼习惯；拉丁名取首尾两段的首字母。中性配色保留给「未指派」「系统」这类并非具体人员的位置。" />

    <TextBlock Classes="sub" Text="GridSplitter" />
    <Border Classes="panel">
      <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource ControlCornerRadius}"
              ClipToBounds="True"
              Width="420" Height="72">
        <Grid ColumnDefinitions="120,4,*">
          <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <Border Grid.Column="2" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
        </Grid>
      </Border>
    </Border>
    <TextBlock Classes="note" MaxWidth="700"
               Text="4px 宽的命中区，其中仅绘制 1px 分隔线——手指和鼠标需要足够的命中面积，视觉上又不能成为一条粗线。悬停时线变为 accent，这是提示「此处可拖动」的唯一信号。" />

    <TextBlock Classes="sub" Text="Toast — 会自动消失，不占布局" />
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <fc:Toast Severity="Success" Title="配方已保存" Message="Recipe-042 · 3 处参数变更" />
        <fc:Toast Severity="Error" Title="导出失败" Message="目标目录不可写">
          <fc:Toast.ActionContent>
            <Button Content="重试" />
          </fc:Toast.ActionContent>
        </fc:Toast>
      </StackPanel>
    </Border>
    <TextBlock Classes="note" MaxWidth="700"
               Text="此处为静态样例，真实的 Toast 承载于 OverlayLayer，右下角堆叠，不进入页面布局。Toast 与 InfoBar 分工不同：Toast 瞬时、脱离布局、可忽略；InfoBar 占布局、需要处置。" />

    <TextBlock Classes="sub" Text="交互演示 — 完整执行一遍流程，弹出真实的 Toast" />
    <Border Classes="play">
      <StackPanel Spacing="16">

        <fc:Stepper x:Name="Flow" CurrentIndex="0" Width="620">
          <fc:StepperItem Content="选择配方" />
          <fc:StepperItem x:Name="StepVerify" Content="参数校验" />
          <fc:StepperItem Content="通道分配" />
          <fc:StepperItem Content="安全确认" />
          <fc:StepperItem Content="开始运行" />
        </fc:Stepper>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="Prev" Content="上一步" />
          <Button x:Name="Next" Classes="accent" Content="下一步" />
          <Button x:Name="Fail" Content="让「参数校验」失败" />
          <Button x:Name="Done" Content="完成提示" />
        </StackPanel>

        <TextBlock Classes="note" MaxWidth="700"
                   Text="位于最后一步时点击「下一步」会弹出成功 Toast，4 秒后自动消失。失败按钮弹出的一条带「重试」，停留 8 秒——需要先读完内容再决定是否点击。因此报警绝不能使用 Toast。" />

        <StackPanel x:Name="ChipRow" Orientation="Horizontal" Spacing="8">
          <fc:Chip Content="配方：PES" />
          <fc:Chip Content="近 7 天" />
          <fc:Chip Content="通道 1–4" />
          <fc:Chip Content="仅异常批次" IsAccent="True" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ResetChips" Content="恢复筛选条件" />
          <TextBlock Classes="note" VerticalAlignment="Center"
                     Text="点击 × 删除标签。全部删除后该行整体消失，不应留下一条空的筛选栏占用空间。" />
        </StackPanel>

      </StackPanel>
    </Border>

    <g:MapBlock Note="ToastHost.Show(owner, toast) 即全部 API——查找 OverlayLayer、创建宿主、到时撤除均由其内部完成。IsError 不在 CurrentIndex 的通知链上，修改后需调用一次 Stepper.RefreshStates()。">
      <g:MapRow Key="控件" Value="Stepper · Chip · GridSplitter（Avalonia 内置）· Toast / ToastHost · PersonPicture" />
      <g:MapRow Key="Toast" Value="用 OverlayLayer 承载，不进视觉树布局。停留 4 s，带操作按钮的延长至 8 s" />
      <g:MapRow Key="伪类" Value="StepperItem: :pending :done :current :error :last · Chip: :closable :accent · PersonPicture: :small :medium :large :neutral · Toast: :informational :success :error" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
