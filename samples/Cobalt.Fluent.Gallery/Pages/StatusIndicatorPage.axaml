<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.StatusIndicatorPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="StatusIndicator" />
      <Border Classes="tag"><TextBlock Text="7 · HMI 专用" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="三重编码：颜色 + 形状/动效 + 文字。任一通道单独使用均不可靠——男性约 8% 有色觉障碍，强光下的工业屏幕颜色也会失真。因此 offline 为空心圈、running 带脉冲环、warning/fault 分别使用独立字形。" />

    <TextBlock Classes="sub" Text="五个状态" />
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <fc:StatusIndicator State="Offline" Label="未连接" />
        <fc:StatusIndicator State="Idle"    Label="待机" />
        <fc:StatusIndicator State="Running" Label="运行中" />
        <fc:StatusIndicator State="Warning" Label="参数偏离" />
        <fc:StatusIndicator State="Fault"   Label="超温停机" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="嵌入式：关闭脉冲动画" />
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <fc:StatusIndicator State="Running" Label="运行中（脉冲开）" />
        <fc:StatusIndicator State="Running" Label="运行中（脉冲关，保留静态外环）" IsPulseEnabled="False" />
        <TextBlock Classes="note" MaxWidth="560"
                   Text="单屏十几个 running 指示灯即对应十几个并发动画，在 Mali 这类 GPU 上会掉帧。关闭脉冲后外环变为静态，形状编码不受影响。" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="交互演示 — 循环切换状态" />
    <Border Classes="play">
      <StackPanel Spacing="16">
        <fc:StatusIndicator x:Name="Live" State="Running" Label="运行中" />
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="NextState" Content="下一个状态" />
          <TextBlock x:Name="StateName" Classes="note" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <g:MapBlock Note="脉冲环使用 Animation + ScaleTransform，仅作用于 transform/opacity。嵌入式环境下若单屏有十几个 running 指示灯，应关闭 IsPulseEnabled——十几个并发动画在 Mali 上会掉帧。">
      <g:MapRow Key="类型" Value="StatusIndicator : TemplatedControl" />
      <g:MapRow Key="属性" Value="State:{Offline,Idle,Running,Warning,Fault} · Label · ShowLabel=true · IsPulseEnabled=true" />
      <g:MapRow Key="伪类" Value=":offline :idle :running :warning :fault（属性变化时通过 PseudoClasses.Set 设置）" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
