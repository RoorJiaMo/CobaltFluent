<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.FoundationsPage">

  <StackPanel HorizontalAlignment="Left" MaxWidth="860">

    <StackPanel.Styles>
      <!-- 这一节全是文字，条目多。标题一行、正文一行，比挤成一段好扫。 -->
      <Style Selector="TextBlock.rule-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style Selector="TextBlock.rule">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
      <!-- 伪类表两列都是代码，等宽才对得齐 -->
      <Style Selector="TextBlock.cell">
        <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style Selector="TextBlock.cell-head">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      </Style>
    </StackPanel.Styles>

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="设计基线" />
      <Border Classes="tag"><TextBlock Text="总则" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="全库共用的几条硬性规则。它们不是风格偏好，而是 57 个控件同屏呈现仍能分辨层次的前提——单独审视一个控件时，多种画法都可成立；多个控件并列时，只有一套一致的层、圆角、阴影和字重才能避免视觉冲突。后面每一节的规格都建立在这四条之上。" />

    <TextBlock Classes="sub" Text="画面只有两层 — base layer / content layer" />
    <Border Classes="panel" HorizontalAlignment="Stretch">
      <StackPanel Spacing="14">
        <StackPanel>
          <TextBlock Classes="rule-title" Text="base layer — 窗口底" />
          <TextBlock Classes="rule" Text="SolidBackgroundFillColorBaseBrush 的实色底。导航面板、CommandBar、DataGridToolbar、Pagination 均位于这一层——它们属于框架而非内容，不应置入卡片。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="content layer — 内容区" />
          <TextBlock Classes="rule" Text="半透明的 LayerFillColorDefaultBrush + 1px 描边，朝向窗口内侧的角切 8px 圆角。数据、表格、表单位于这一层。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="Card 不是第三层" />
          <TextBlock Classes="rule" Text="Card 是 content layer 内部的分区：4px 圆角、半透明底 + 1px 描边、不加阴影。若需要再叠一层，通常说明信息应拆分为独立页面。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="弹出层悬浮于两层之上" />
          <TextBlock Classes="rule" Text="ToolTip / Flyout / MenuFlyout / ContentDialog / TeachingTip 不参与这两层的排布，它们依靠阴影表达悬浮层级，也是全库唯一带阴影的元素。" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="最典型的层级错误是将 CommandBar 置入 Card：工具栏随内容一起呈半透明，下方表格的视觉密实度反而高于工具栏。" />

    <TextBlock Classes="sub" Text="圆角只有 8 / 4 / 0 三个值" />
    <Border Classes="panel" HorizontalAlignment="Stretch">
      <StackPanel Spacing="14">
        <StackPanel>
          <TextBlock Classes="rule-title" Text="8 — OverlayCornerRadius" />
          <TextBlock Classes="rule" Text="窗口、ContentDialog、Flyout、MenuFlyout、ComboBox 和日期控件展开的面板。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="4 — ControlCornerRadius" />
          <TextBlock Classes="rule" Text="按钮、输入框、列表项、进度条、Card。ToolTip 也取 4——它是唯一采用控件圆角的弹出层，因尺寸较小，取 8 视觉上过圆。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="0 — 相接处" />
          <TextBlock Classes="rule" Text="SplitButton 左半 4,0,0,4、右半 0,4,4,0，中间一条 1px 分隔；SettingsGroup 成组时只有首尾圆角，中间项若加圆角会破坏整组的连续性。" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="相接处使用 ControlCornerRadiusLeft / Right / Top / Bottom 这组固定值键，不应绑定 ControlCornerRadius——否则修改全局圆角时相接处会出现缝隙。唯一不遵循 8/4/0 的是日历格：36×36 配 CornerRadius 18，为正圆。" />

    <TextBlock Classes="sub" Text="阴影仅用于悬浮层" />
    <Border Classes="panel" HorizontalAlignment="Stretch">
      <StackPanel Spacing="14">
        <StackPanel>
          <TextBlock Classes="rule-title" Text="三档，对应三种悬浮高度" />
          <TextBlock Classes="rule" Text="ToolTip 0 4 8；Flyout / MenuFlyout / 下拉面板 0 8 16；ContentDialog 0 32 64，另加 Smoke 遮罩。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="页面内元素一律以描边区分" />
          <TextBlock Classes="rule" Text="Card、Expander、SettingsCard、展示面板均不加阴影。以阴影区分同层元素是 Material 的方案，Fluent 依靠描边和填充深浅。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="亚克力和描边成对" />
          <TextBlock Classes="rule" Text="Flyout 用 SurfaceStrokeColorFlyoutBrush，常驻面板用 SurfaceStrokeColorDefaultBrush，混用会造成视觉错误。嵌入式 Linux / Mali GPU 上应关闭亚克力并改用实色，描边保持不变。" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="字重只有 400 / 600" />
    <Border Classes="panel" HorizontalAlignment="Stretch">
      <StackPanel Spacing="14">
        <StackPanel>
          <TextBlock Classes="rule-title" Text="Regular 400 — 默认正文" />
          <TextBlock Classes="rule" Text="绝大多数 UI 文字，包括 Body Large 和 Title Large。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="Semibold 600 — 强调" />
          <TextBlock Classes="rule" Text="表头、卡片小标题、Subtitle 和 Title。强调用 Semibold，不用 Bold（700），也不用斜体——中文没有真正的斜体，合成斜体在小字号下字形模糊。" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="状态伪类 — 全库共用同一组" />
    <Border Classes="panel" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="260,*" RowSpacing="7" ColumnSpacing="16"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="cell-head" Text="伪类" />
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="cell-head" Text="设置方与触发时机" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="cell" Text=":pointerover" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="cell" Text="Avalonia 内置 — 指针悬停" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="cell" Text=":pressed" />
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="cell" Text="Avalonia 内置 — 指针按下期间" />

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="cell" Text=":disabled" />
        <TextBlock Grid.Row="3" Grid.Column="1" Classes="cell" Text="Avalonia 内置 — IsEnabled=False，沿视觉树向下传递" />

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="cell" Text=":focus-visible" />
        <TextBlock Grid.Row="4" Grid.Column="1" Classes="cell" Text="Avalonia 内置 — 仅键盘导航获得的焦点绘制焦点框，鼠标点击获得的焦点不绘制" />

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="cell" Text=":checked / :indeterminate" />
        <TextBlock Grid.Row="5" Grid.Column="1" Classes="cell" Text="Avalonia 内置 — ToggleButton 系列的 IsChecked" />

        <TextBlock Grid.Row="6" Grid.Column="0" Classes="cell" Text=":selected / :expanded" />
        <TextBlock Grid.Row="6" Grid.Column="1" Classes="cell" Text="Avalonia 内置 — 列表项选中 / Expander 展开" />

        <TextBlock Grid.Row="7" Grid.Column="0" Classes="cell" Text=":error" />
        <TextBlock Grid.Row="7" Grid.Column="1" Classes="cell" Text="本库 — 校验不通过；优先级高于 :pointerover，低于 :disabled" />

        <TextBlock Grid.Row="8" Grid.Column="0" Classes="cell" Text=":dirty · :jogging · :engaged" />
        <TextBlock Grid.Row="8" Grid.Column="1" Classes="cell" Text="本库第 7 组 — 在属性变更处理中调用 PseudoClasses.Set(&quot;:dirty&quot;, v)" />

        <TextBlock Grid.Row="9" Grid.Column="0" Classes="cell" Text=":rangestart · :inrange · :rangeend" />
        <TextBlock Grid.Row="9" Grid.Column="1" Classes="cell" Text="本库 — RangeCalendar 按选中区间的首尾自动设置" />
      </Grid>
    </Border>
    <TextBlock Classes="note"
               Text="内置伪类不应重复实现：Avalonia 已提供 :pointerover，就不应再自行维护 IsHovered 属性——两套状态最终会不同步。反之，第 7 组的语义（写入未确认、正在点动、已使能）内置伪类不涵盖，必须自行 Set，并在类上用 [PseudoClasses] 标注，否则后续维护者只能查阅实现才能得知有哪些状态。" />

    <TextBlock Classes="sub" Text="变量层 / 控件层 — 分层是更换外观的前提" />
    <Border Classes="panel" HorizontalAlignment="Stretch">
      <StackPanel Spacing="14">
        <StackPanel>
          <TextBlock Classes="rule-title" Text="变量层 — Themes/Tokens.axaml" />
          <TextBlock Classes="rule" Text="只含颜色、不含控件。79 个键各配明暗两档，位于 ResourceDictionary.ThemeDictionaries 的 Light / Dark 两个分区。该文件由 tools/gen_tokens.py 从 tools/palette.json 生成，不应手工修改。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="控件层 — Themes/Controls/*.axaml" />
          <TextBlock Classes="rule" Text="只引用变量、不出现任何 hex。唯一的例外是弹出层的 BoxShadow——其语法只接受颜色、不接受画刷，且这两层黑色为固定不透明度、不随主题变化。" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="rule-title" Text="分层的目的是更换外观时控件层一行不改" />
          <TextBlock Classes="rule" Text="更换主题色、实现高对比度、为不同产品线定制外观，均只修改变量层。控件层一旦出现裸色值，上述定制方式即失效——因此这是本库唯一由自动化检查约束的硬性规则。" />
        </StackPanel>
      </StackPanel>
    </Border>

    <g:MapBlock Note="这四条规则在后续各节均有对应体现：圆角见 SplitButton 和 SettingsGroup 的相接处，阴影见第 6 组的三档高度，层见 CommandBar 的归属层级，字重见「排版」一节的七档字阶。第 7 组另有一条附加规则——安全色不跟随主题，急停和 alarm 级报警用 SafetyRedBrush，不应使用 SystemFillColorCriticalBrush（后者深色下为浅粉色）。">
      <g:MapRow Key="层" Value="SolidBackgroundFillColorBaseBrush（base layer）· LayerFillColorDefaultBrush（content layer）· CardBackgroundFillColorDefaultBrush（Card）· AcrylicBackgroundFillColorDefaultBrush（弹出层）" />
      <g:MapRow Key="圆角" Value="OverlayCornerRadius=8 · ControlCornerRadius=4 · ControlCornerRadiusLeft/Right/Top/Bottom（相接处，固定值、不绑定）· CalendarDayButtonCornerRadius=18（唯一的正圆）" />
      <g:MapRow Key="阴影" Value="只在 ToolTip / Flyout / MenuFlyout / ContentDialog / TeachingTip 五个 ControlTheme 中出现；BoxShadow 只接受颜色、不接受画刷，因此该处是全库唯一写字面色值的位置" />
      <g:MapRow Key="字重" Value="Normal(400) · SemiBold(600)，没有 Bold、没有斜体。七档字阶见「排版 Typography」" />
      <g:MapRow Key="伪类" Value="内置 :pointerover · :pressed · :disabled · :focus-visible · :checked · :selected · :expanded；本库另加 :error 和第 7 组各伪类，均在类上用 [PseudoClasses] 标注" />
      <g:MapRow Key="生成物" Value="Themes/Tokens.axaml（tools/gen_tokens.py ← tools/palette.json）· Themes/CobaltFluentTheme.axaml 的合并列表（tools/gen_theme_index.py，编译前自动重建）· docs/CONTROLS.md（tools/gen_api_docs.py）" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
