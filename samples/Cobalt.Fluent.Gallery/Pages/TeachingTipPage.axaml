<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.TeachingTipPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="TeachingTip" />
      <Border Classes="tag"><TextBlock Text="6 · 弹出" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="带 beak（尖角）指向目标元素的引导浮层。实色底而非亚克力——须遮蔽下层内容以保证文字可读。用于首次使用引导，不用于常规提示。" />

    <TextBlock Classes="sub" Text="本体 — 标题 + 一句正文 + 最多两个按钮" />
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <!-- 目标固定 140 宽，提示左移 40：beak 钉死在离左边 24 的位置（+6 是它自己的一半），
             40+30 正好落在按钮中线上。这道算术是调用方的活，控件不替你找目标。 -->
        <Button Content="并行通道调度" Width="140" HorizontalAlignment="Left" />
        <fc:TeachingTip x:Name="SpecTip"
                        Margin="40,0,0,0"
                        Title="新增：并行通道调度"
                        Subtitle="现在可以在同一配方里为 4 个通道分别设定温度曲线，互不干扰。"
                        ActionButtonContent="查看示例"
                        CloseButtonContent="知道了" />
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="beak 位置须对准触发元素，默认距左边 24px。同一会话内最多出现一个 TeachingTip——连续弹出两个即构成打扰，自第三个起不再被阅读。标题一行、正文一句，容纳不下的内容应放入文档或 ContentDialog，不应放在此处。样张中点按「知道了」会立即重新打开：规格样张不应因点按而消失。" />

    <TextBlock Classes="sub" Text="四个方向 — Placement 指提示位于目标的哪一侧，beak 绘制在对侧" />
    <Border Classes="panel">
      <!-- 中间那颗按钮是唯一的目标，四条提示各占一边，beak 都对着它。
           上下两条跨列、左右两条跨行：不跨的话，220 宽的提示会把中间那格撑到 220，
           按钮缩在格子左上角，另外两条的 beak 就指到空气上去了。 -->
      <Grid ColumnDefinitions="Auto,16,Auto,16,Auto" RowDefinitions="Auto,16,Auto,16,Auto">

        <fc:TeachingTip Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Width="220"
                        Placement="Top" VerticalAlignment="Bottom"
                        Title="Placement=Top"
                        Subtitle="提示在目标上方，beak 朝下。"
                        CloseButtonContent="" />

        <fc:TeachingTip Grid.Row="2" Grid.Column="0" Grid.RowSpan="3" Width="220"
                        Placement="Left" VerticalAlignment="Top"
                        Title="Placement=Left"
                        Subtitle="提示在目标左侧，beak 朝右。"
                        CloseButtonContent="" />

        <!-- 下移 14：按钮中线落在 30，正是 beak 那条 24+6 的线。
             横向同理——按钮 64 宽（MinWidth 撑的），中线 32，对上左端 30 的 beak。 -->
        <Button Grid.Row="2" Grid.Column="2" Content="调度"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,14,0,0" />

        <fc:TeachingTip Grid.Row="2" Grid.Column="4" Grid.RowSpan="3" Width="220"
                        Placement="Right" VerticalAlignment="Top"
                        Title="Placement=Right"
                        Subtitle="提示在目标右侧，beak 朝左。"
                        CloseButtonContent="" />

        <fc:TeachingTip Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Width="220"
                        Placement="Bottom"
                        Title="Placement=Bottom（默认）"
                        Subtitle="提示在目标下方，beak 朝上。"
                        CloseButtonContent="" />

      </Grid>
    </Border>
    <TextBlock Classes="note"
               Text="这四条示例将关闭按钮留空仅为排版所需——实际向用户弹出的提示必须保留关闭出口。方向的选择取决于可用空间：提示不得遮盖其所介绍的目标元素，空间不足时应改换方向。" />

    <TextBlock Classes="sub" Text="与 ToolTip 的区别 — 并非「小提示」与「大提示」之分" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="40">

        <StackPanel Spacing="10" Width="280">
          <TextBlock Classes="note" Margin="0" Text="ToolTip — 悬停即显示，移开即消失" />
          <Button Content="下发配方" HorizontalAlignment="Left"
                  ToolTip.Tip="把当前配方写入设备，运行中不可下发" />
          <TextBlock Classes="note"
                     Text="仅在用户主动悬停时出现，无按钮、无需关闭、不记录已读状态；同一按钮悬停一百次即显示一百次。其回答的问题是「这是什么」。" />
        </StackPanel>

        <StackPanel Spacing="10" Width="300">
          <TextBlock Classes="note" Margin="0" Text="TeachingTip — 程序主动弹出，需用户确认" />
          <fc:TeachingTip x:Name="CompareTip" Width="300"
                          Title="配方现在能下发到多台设备"
                          Subtitle="选中多台设备后再点下发，参数一次写到底。"
                          ActionButtonContent="试一次"
                          CloseButtonContent="知道了" />
          <TextBlock Classes="note"
                     Text="由程序主动弹出，未经点按关闭不会消失；关闭后须记录已读，下次不再弹出。其说明的是「新增了什么、在何处使用」——用户原本并未寻找该信息。" />
        </StackPanel>

      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="判定标准明确：内容若可等到用户需要时再查看，即适用 ToolTip。反之，将常驻说明放入 TeachingTip，用户关闭后该信息无法再次获取——引导是一次性的，说明不是。" />

    <TextBlock Classes="sub" Text="交互演示 — 一次性引导的完整流程" />
    <Border Classes="play">
      <StackPanel Spacing="16">

        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Content="单通道" Width="88" />
            <Button Content="并行通道" Width="88" />
            <Button Content="报表" Width="88" />
          </StackPanel>
          <!-- 三颗 88 宽、间距 8：第二颗中线在 140，减掉 beak 那 30 就是 110 -->
          <fc:TeachingTip x:Name="PlayTip"
                          Margin="110,0,0,0"
                          Title="新增：并行通道调度"
                          Subtitle="现在可以在同一配方里为 4 个通道分别设定温度曲线，互不干扰。"
                          ActionButtonContent="查看示例"
                          CloseButtonContent="知道了" />
        </StackPanel>

        <Button x:Name="Rearm" Content="清除「已读」标记并再次弹出" HorizontalAlignment="Left" />

        <TextBlock x:Name="PlayLog" Classes="note" MaxWidth="700" />
        <TextBlock Classes="note" MaxWidth="700"
                   Text="两个按钮点按任一均记为已读，不设第三种出路——「以后再说」类选项会导致同一条引导反复出现。动作按钮的语义是「点按后直接前往目标」，而非「点按后还需再关闭一次」：ActionCommand 执行完毕后控件自动关闭。" />

      </StackPanel>
    </Border>

    <g:MapBlock Note="WinUI 的 Target / PreferredPlacement / IsLightDismissEnabled 本库均未实现：该 TeachingTip 就地置于布局中，位置由调用方确定——嵌入式全屏应用无需规避窗口边界，多套一层 Popup 在 X11 下反而会闪烁。轻关闭同为有意不实现：点按旁侧即消失的引导等同于未弹出。">
      <g:MapRow Key="类型" Value="TeachingTip : TemplatedControl（Avalonia 本体未提供，本库自带）" />
      <g:MapRow Key="属性" Value="Title · Subtitle · ActionButtonContent · CloseButtonContent（默认「知道了」）· ActionCommand · Placement={Top,Bottom,Left,Right}（默认 Bottom）· IsOpen（双向，与 IsVisible 联动）" />
      <g:MapRow Key="成员" Value="Close()（幂等）· Closed 事件——两个按钮均经由该事件，动作按钮先执行 ActionCommand 再关闭" />
      <g:MapRow Key="伪类" Value=":top / :bottom / :left / :right——由 Placement 推导，主题据此将 beak 移至对侧、并更换留边的那两条" />
      <g:MapRow Key="资源键" Value="WinUI 的 TeachingTipTransientBackground 在本库映射为 SolidBackgroundFillColorQuarternaryBrush（实色，非亚克力）· SurfaceStrokeColorFlyoutBrush · OverlayCornerRadius（8px）" />
      <g:MapRow Key="阴影" Value="BoxShadow=&quot;0 8 16 0 #24000000, 0 0 2 0 #1F000000&quot;（shadow-flyout，与 Flyout 同档；全库仅弹出层可使用阴影）" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
