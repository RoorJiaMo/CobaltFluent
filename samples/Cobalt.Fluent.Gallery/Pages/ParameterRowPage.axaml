<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.ParameterRowPage">

  <StackPanel HorizontalAlignment="Left" MaxWidth="920">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="ParameterRow" />
      <Border Classes="tag"><TextBlock Text="7 · HMI 专用" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="过程控制的主要控件。核心在于区分「本地已修改」与「设备已接收」两种状态——两者之间的空窗期是事故高发区：操作员修改数值后离开，误以为已生效，实际值仍停留在输入框中。" />

    <TextBlock Classes="sub" Text="状态矩阵 — 五个态" />
    <Border Classes="panel" HorizontalAlignment="Stretch">
      <fc:ParameterTable x:Name="SpecTable" />
    </Border>

    <TextBlock Classes="sub" Text="交互演示 —— 该控件的交互即其规格" />
    <Border Classes="play" HorizontalAlignment="Stretch">
      <StackPanel Spacing="12">
        <fc:ParameterTable x:Name="PlayTable" />
        <TextBlock Classes="note" MaxWidth="820"
                   Text="将「腔体温度」修改为 86.3 并下发：状态依次经过 待下发 → 写入中 → 已生效，而输入框最终显示 86.5 —— 该值为设备按 0.5 步进量化后回读的结果，并非输入的 86.3。修改「进料压力」会下发失败，值回滚到上次成功值。「主轴转速」超出 0–3000 时下发按钮被禁用。" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="PendingText 与已生效值不同即 :dirty。下发成功后调用 CompleteWrite(回读值) —— 传入的必须是设备回读的值，而非刚写入的值：设备可能进行限幅或量化，直接显示输入值会造成误导。失败时调用 FailWrite()，值回滚到上次成功值。">
      <g:MapRow Key="类型" Value="ParameterRow : TemplatedControl（容器 ParameterTable : ItemsControl）" />
      <g:MapRow Key="属性" Value="Label · Unit · ActualValue:double? · Setpoint · PendingText · Minimum · Maximum · Format · IsReadOnly · WriteState:{Clean,Dirty,Writing,Failed,OutOfRange} · ApplyCommand · RevertCommand" />
      <g:MapRow Key="方法" Value="Apply() · CompleteWrite(readback) · FailWrite(message) · Revert()" />
      <g:MapRow Key="伪类" Value=":dirty :writing :failed :outofrange :readonly" />
      <g:MapRow Key="列宽" Value="标签 * / 读值 96 / 设定 140 / 单位 56 / 状态 auto —— 表头和行使用同一组列宽，同容器内自然对齐" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
