<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.ProgressRingPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="ProgressRing" />
      <Border Classes="tag"><TextBlock Text="5 · 反馈" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="线宽随直径自动缩放，无需手动指定。嵌入式（Mali GPU）上该持续动画为常驻开销，长时间加载建议改用 ProgressBar 的 indeterminate——后者仅对 transform 做动画，开销显著更低。" />

    <TextBlock Classes="sub" Text="三档尺寸" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="32" VerticalAlignment="Center">
        <fc:ProgressRing Width="20" Height="20" />
        <fc:ProgressRing Width="32" Height="32" />
        <fc:ProgressRing Width="64" Height="64" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="确定进度" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="32" VerticalAlignment="Center">
        <fc:ProgressRing Width="48" Height="48" IsIndeterminate="False" Value="25" />
        <fc:ProgressRing Width="48" Height="48" IsIndeterminate="False" Value="60" />
        <fc:ProgressRing Width="48" Height="48" IsIndeterminate="False" Value="100" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="嵌入式（Mali GPU）上该持续动画为常驻开销。同屏多个旋转动画会明显掉帧，长时间加载应改用 ProgressBar 的 indeterminate。">
      <g:MapRow Key="控件" Value="ProgressRing（本库自定义，Avalonia 本体未提供）" />
      <g:MapRow Key="属性" Value="IsIndeterminate · Value / Minimum / Maximum · Width/Height（线宽自动按比例）· StrokeThickness（需手动指定线宽时使用）" />
      <g:MapRow Key="资源键" Value="AccentFillColorDefaultBrush（值弧）· ControlAltFillColorSecondaryBrush（底环）" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
