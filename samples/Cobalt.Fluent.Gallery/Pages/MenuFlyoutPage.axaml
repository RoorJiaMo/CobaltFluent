<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.MenuFlyoutPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="MenuFlyout" />
      <Border Classes="tag"><TextBlock Text="6 · 弹出" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="面板内边距 0,2,0,2，项最小高 32、内边距 11,8,11,9、外边距 4,2,4,2。这些均为 WinUI 原值，直接沿用即可。" />

    <TextBlock Classes="sub" Text="面板本体 — 平铺展示" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="24">

        <!-- 摆真的 MenuFlyoutPresenter，不照着规格另画一张贴上来。
             菜单平时只在 Popup 里露一瞬，仿一份就成了两套东西：改了 ControlTheme 这里不跟着变。 -->
        <MenuFlyoutPresenter Width="220" VerticalAlignment="Top">
          <MenuItem Header="运行" InputGesture="F5">
            <MenuItem.Icon><fc:SymbolIcon Symbol="Play" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="暂停" InputGesture="F6">
            <MenuItem.Icon><fc:SymbolIcon Symbol="Pause" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="停止" InputGesture="F7" IsEnabled="False">
            <MenuItem.Icon><fc:SymbolIcon Symbol="Stop" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="另存为配方…">
            <MenuItem.Icon><fc:SymbolIcon Symbol="Save" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="导出数据">
            <MenuItem.Icon><fc:SymbolIcon Symbol="Download" /></MenuItem.Icon>
            <MenuItem Header="导出 CSV" />
            <MenuItem Header="导出 Excel" />
          </MenuItem>
          <Separator />
          <MenuItem Header="属性">
            <MenuItem.Icon><fc:SymbolIcon Symbol="Settings" /></MenuItem.Icon>
          </MenuItem>
        </MenuFlyoutPresenter>

        <StackPanel Spacing="0" MaxWidth="320" VerticalAlignment="Center">
          <TextBlock Classes="note" Margin="0"
                     Text="图标列固定 16px 宽并始终占位，无图标的项同样保留空位——否则同一菜单内的文字会左右错位。快捷键右对齐，使用 secondary 色。" />
          <TextBlock Classes="note"
                     Text="「导出数据」右端的箭头仅在存在子项时绘制，并非手动添加的装饰。指针经过该项时子菜单展开，在右侧紧贴父项显示。" />
        </StackPanel>

      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="图标列 — 有无图标均占用同一栏位" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="24">

        <StackPanel Spacing="8">
          <MenuFlyoutPresenter Width="200">
            <MenuItem Header="运行" InputGesture="F5">
              <MenuItem.Icon><fc:SymbolIcon Symbol="Play" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="暂停" InputGesture="F6">
              <MenuItem.Icon><fc:SymbolIcon Symbol="Pause" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="复位计数器" />
            <MenuItem Header="清零累计量" />
          </MenuFlyoutPresenter>
          <TextBlock Classes="note" Margin="0" Text="混合排列：后两项无图标，文字仍对齐在第三列" />
        </StackPanel>

        <StackPanel Spacing="8">
          <MenuFlyoutPresenter Width="200">
            <MenuItem Header="复制" InputGesture="Ctrl+C" />
            <MenuItem Header="粘贴" InputGesture="Ctrl+V" />
            <MenuItem Header="删除" InputGesture="Delete" />
          </MenuFlyoutPresenter>
          <TextBlock Classes="note" Margin="0" Text="整个菜单均无图标：该列宽度归零，不保留多余空边" />
        </StackPanel>

        <TextBlock Classes="note" Margin="0" MaxWidth="260" VerticalAlignment="Center"
                   Text="两种对齐均非硬编码宽度：图标 / 快捷键 / 箭头三列均使用 SharedSizeGroup，同一面板内按最宽项统一。因此菜单中只要有一项带图标，所有项都会保留该栏位。" />

      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="项的状态 — 指针悬停与键盘导航为同一档" />
    <g:SpecMatrix States="rest,pointerover,selected,disabled">
      <g:SpecMatrix.Sample>
        <DataTemplate>
          <MenuItem Header="另存为配方…" InputGesture="Ctrl+Shift+S">
            <MenuItem.Icon><fc:SymbolIcon Symbol="Save" /></MenuItem.Icon>
          </MenuItem>
        </DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>
    <TextBlock Classes="note"
               Text="鼠标悬停触发 :pointerover，键盘上下导航触发 :selected，两者使用同一档 SubtleFillColorSecondary——菜单中「当前项」只有一个概念，区分两种深浅会被误解为两种状态。禁用项仅降低文字色，背景不变：叠加灰底会使其在视觉上近似选中态。" />

    <TextBlock Classes="sub" Text="交互演示 — 按钮触发" />
    <Border Classes="play">
      <StackPanel Spacing="12">
        <DropDownButton x:Name="ActionButton" Content="操作">
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuItem Header="运行" InputGesture="F5">
                <MenuItem.Icon><fc:SymbolIcon Symbol="Play" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="暂停" InputGesture="F6">
                <MenuItem.Icon><fc:SymbolIcon Symbol="Pause" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="停止" IsEnabled="False">
                <MenuItem.Icon><fc:SymbolIcon Symbol="Stop" /></MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock x:Name="ActionLog" Classes="note" Margin="0" />
        <TextBlock Classes="note" Margin="0"
                   Text="点按按钮打开，点按面板外任意位置或按 Esc 关闭——即 light dismiss，Avalonia 的 Flyout 默认即为该行为（IsLightDismissEnabled）。菜单项上显示的 F5 / F6 仅为文字标注，按键实际生效需另行注册 KeyBinding。" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="交互演示 — 右键菜单" />
    <Border Classes="play">
      <StackPanel Spacing="12">
        <ListBox x:Name="RecipeList" Width="280" Height="148" SelectedIndex="0">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="运行" InputGesture="F5">
                <MenuItem.Icon><fc:SymbolIcon Symbol="Play" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="另存为配方…">
                <MenuItem.Icon><fc:SymbolIcon Symbol="Save" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="导出数据">
                <MenuItem.Icon><fc:SymbolIcon Symbol="Download" /></MenuItem.Icon>
                <MenuItem Header="导出 CSV" />
                <MenuItem Header="导出 Excel" />
              </MenuItem>
              <Separator />
              <MenuItem Header="删除">
                <MenuItem.Icon><fc:SymbolIcon Symbol="Cancel" /></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBoxItem Content="Recipe-041 · 退火" />
          <ListBoxItem Content="Recipe-042 · 双温区" />
          <ListBoxItem Content="Recipe-043 · 快速烘干" />
          <ListBoxItem Content="Recipe-044 · 清洗" />
        </ListBox>
        <TextBlock x:Name="ContextLog" Classes="note" Margin="0" />
        <TextBlock Classes="note" Margin="0"
                   Text="右键先选中所在行，再弹出菜单——Avalonia 默认右键不改变选中项，若缺少该处理，菜单中的「删除」作用于上一次左键选中的行，操作对象与视觉焦点不一致。触摸屏上还需为长按提供同一路径，否则这些命令在现场无法触达。" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="子菜单的 Popup 上固定设置 HorizontalOffset=&quot;-4&quot;（对应 WinUI 的 MenuFlyoutSubItemPopupHorizontalOffset），抵消菜单项的 4px 外边距，使子菜单与父项贴合。InputGesture 仅负责绘制文字，不绑定按键；实际快捷键注册在窗口的 KeyBindings 上。">
      <g:MapRow Key="控件" Value="MenuFlyout · MenuFlyoutPresenter · MenuItem · Separator · ContextMenu" />
      <g:MapRow Key="资源键" Value="MenuFlyoutPresenterPadding=0,2,0,2 · MenuFlyoutItemPadding=11,8,11,9 · MenuFlyoutItemMargin=4,2,4,2 · MenuFlyoutItemMinHeight=32 · OverlayCornerRadius" />
      <g:MapRow Key="选择器" Value="MenuItem:pointerover · MenuItem:selected（键盘导航到达）· MenuItem:disabled · MenuItem:icon（存在 Icon 时才绘制该列）· MenuItem:empty（无子项时不绘制箭头）· MenuItem:separator（Header=&quot;-&quot;）" />
      <g:MapRow Key="分隔线" Value="Separator · Height=1 · Margin=0,1,0,1 · DividerStrokeColorDefaultBrush（比 SurfaceStroke 淡一档——其分隔的是同一面板内的两组内容，而非两个面板）" />
      <g:MapRow Key="挂载" Value="&lt;Button.Flyout&gt;&lt;MenuFlyout/&gt;&lt;/Button.Flyout&gt; · &lt;X.ContextMenu&gt;&lt;ContextMenu/&gt;&lt;/X.ContextMenu&gt; · MenuFlyout.ShowAt(target) · MenuItem.Icon / InputGesture / Click" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
