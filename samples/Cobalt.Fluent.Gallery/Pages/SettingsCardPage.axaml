<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.SettingsCardPage">

  <StackPanel Spacing="0" HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="SettingsCard" />
      <Border Classes="tag"><TextBlock Text="3 · 容器" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="Win11 设置页的标准行：图标 + 标题 + 说明 + 右侧控件，最小高 68。成组时用 2px 缝隙、仅首尾圆角——中间项若带圆角，整组会失去视觉上的整体性。" />

    <TextBlock Classes="sub" Text="单张 — 说明行可省略" />
    <Border Classes="panel">
      <StackPanel Width="560" Spacing="8">
        <fc:SettingsCard Icon="Save"
                         Header="自动保存"
                         Description="参数变更后立即写入配方文件">
          <ToggleSwitch IsChecked="True" OnContent="开" OffContent="关" />
        </fc:SettingsCard>
        <fc:SettingsCard Icon="Brightness" Header="夜间模式">
          <ToggleSwitch OnContent="开" OffContent="关" />
        </fc:SettingsCard>
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="Description 为空时该行整体不占位，标题恢复垂直居中。68 为最小高而非固定高——说明文字换行至两行时高度自然增加，不应为「对齐」而固定高度。" />

    <TextBlock Classes="sub" Text="成组 — 2px 缝隙、首尾圆角、中间方角" />
    <Border Classes="panel">
      <fc:SettingsGroup Width="560">
        <fc:SettingsCard Icon="Save"
                         Header="自动保存"
                         Description="参数变更后立即写入配方文件">
          <ToggleSwitch IsChecked="True" OnContent="开" OffContent="关" />
        </fc:SettingsCard>
        <fc:SettingsCard Icon="Speed"
                         Header="采样周期"
                         Description="影响趋势曲线的分辨率与磁盘占用">
          <ComboBox Width="120" SelectedIndex="2">
            <ComboBoxItem Content="200 ms" />
            <ComboBoxItem Content="500 ms" />
            <ComboBoxItem Content="1 s" />
            <ComboBoxItem Content="2 s" />
            <ComboBoxItem Content="5 s" />
          </ComboBox>
        </fc:SettingsCard>
        <fc:SettingsCard Icon="Folder"
                         Header="数据目录"
                         Description="D:\Cobalt\Runs">
          <Button Content="浏览" />
        </fc:SettingsCard>
      </fc:SettingsGroup>
    </Border>
    <TextBlock Classes="note"
               Text="中间两处方角是三行呈现为一个整体的关键。2px 缝隙仅负责区分相邻两行，不承担分组语义——分组由外轮廓的圆角传达。" />

    <TextBlock Classes="sub" Text="对照 — 相同的三行，分散放置" />
    <Border Classes="panel">
      <StackPanel Width="560" Spacing="8">
        <fc:SettingsCard Icon="Save"
                         Header="自动保存"
                         Description="参数变更后立即写入配方文件">
          <ToggleSwitch IsChecked="True" OnContent="开" OffContent="关" />
        </fc:SettingsCard>
        <fc:SettingsCard Icon="Speed"
                         Header="采样周期"
                         Description="影响趋势曲线的分辨率与磁盘占用">
          <ComboBox Width="120" SelectedIndex="2">
            <ComboBoxItem Content="200 ms" />
            <ComboBoxItem Content="500 ms" />
            <ComboBoxItem Content="1 s" />
            <ComboBoxItem Content="2 s" />
            <ComboBoxItem Content="5 s" />
          </ComboBox>
        </fc:SettingsCard>
        <fc:SettingsCard Icon="Folder"
                         Header="数据目录"
                         Description="D:\Cobalt\Runs">
          <Button Content="浏览" />
        </fc:SettingsCard>
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="内容完全相同，观感上却成为三件互不相关的条目。设置页中「这几条属于同一组」的信息几乎完全由外轮廓传达，一旦每张卡片各自带圆角，该信息即丢失。" />

    <TextBlock Classes="sub" Text="交互演示 — 增删项时首尾圆角随之重算" />
    <Border Classes="play">
      <StackPanel Spacing="16">
        <fc:SettingsGroup x:Name="PlayGroup" Width="560">
          <fc:SettingsCard Icon="Save"
                           Header="自动保存"
                           Description="参数变更后立即写入配方文件">
            <ToggleSwitch IsChecked="True" OnContent="开" OffContent="关" />
          </fc:SettingsCard>
          <fc:SettingsCard Icon="Speed"
                           Header="采样周期"
                           Description="影响趋势曲线的分辨率与磁盘占用">
            <ComboBox Width="120" SelectedIndex="2">
              <ComboBoxItem Content="200 ms" />
              <ComboBoxItem Content="500 ms" />
              <ComboBoxItem Content="1 s" />
              <ComboBoxItem Content="2 s" />
              <ComboBoxItem Content="5 s" />
            </ComboBox>
          </fc:SettingsCard>
        </fc:SettingsGroup>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="AddRow" Content="添加一项" />
          <Button x:Name="RemoveRow" Content="删除末项" />
        </StackPanel>

        <TextBlock x:Name="PlayLog" Classes="note" Margin="0" />
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="圆角在子项集合变化时重算。临时隐藏某一项应将其从集合中移除——仅把 IsVisible 设为 False 时类不会重新施加，末尾会保留一行方角。" />

    <g:MapBlock Note="FluentAvalonia 提供 SettingsExpander：多个 SettingsExpanderItem 放入 ItemsSource 后首尾圆角自动计算。本库保持零第三方依赖，因此自行实现了一套；代价是圆角需由 SettingsGroup 将类施加到子项上——ControlTheme 中出现后代选择器（^ fc|SettingsCard）时编译可通过、运行时直接抛出异常，该限制无法绕过。">
      <g:MapRow Key="控件" Value="fc:SettingsCard : ContentControl · fc:SettingsGroup : StackPanel（Spacing 固定 2）" />
      <g:MapRow Key="属性" Value="Icon:Symbol · Header · Description · Content（右侧控件槽，ToggleSwitch / ComboBox / Button 均可直接放入）" />
      <g:MapRow Key="类" Value="settings-first · settings-middle · settings-last · settings-only —— 由 SettingsGroup 按可见子项位置自动施加，不应手动指定" />
      <g:MapRow Key="资源键" Value="同 Card —— CardBackgroundFillColorDefaultBrush · CardStrokeColorDefaultBrush · ControlCornerRadius · SettingsCardMinHeight=68" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
