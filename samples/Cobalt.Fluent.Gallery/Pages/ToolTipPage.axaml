<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.ToolTipPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="ToolTip" />
      <Border Classes="tag"><TextBlock Text="5 · 反馈" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="唯一用 4px 圆角的弹出层——因为尺寸太小，8px 会显得过圆。其余弹出层一律 8px。" />

    <TextBlock Classes="sub" Text="提示条本体 — 短文本 / 带快捷键 / 长文本换行" />
    <Border Classes="panel">
      <!-- ToolTip 加进可视树，它就是个套着提示条外观的 ContentControl（Avalonia 自己是这么定义的）。
           所以这三条冻的是真模板：圆角、内边距、那档浅阴影写错了当场露馅，不是照规格另画一张。
           Opacity 本地写 1 —— 主题里默认 0、靠 :open 抬起来，而这三条永远不会 open。 -->
      <StackPanel Spacing="12">

        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Classes="note" Margin="0" Width="80" VerticalAlignment="Center" Text="短文本" />
          <ToolTip Opacity="1" Content="刷新数据" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Classes="note" Margin="0" Width="80" VerticalAlignment="Center" Text="带快捷键" />
          <ToolTip Opacity="1" Content="保存配方 (Ctrl+S)" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Classes="note" Margin="0" Width="80" VerticalAlignment="Top" Text="长文本换行" />
          <ToolTip Opacity="1" Content="重新加载设备参数并重建通信链路，运行中的批次不受影响。" />
        </StackPanel>

      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="宽度封在 320，超了就换行——横穿整屏的提示条比没有还难读。快捷键直接写进那行文字里，不另开槽位：提示条只有一瞬的阅读时间，多一列就多一次找。" />

    <TextBlock Classes="sub" Text="挂上去 — ToolTip.Tip" />
    <Border Classes="panel">
      <StackPanel Spacing="16">

        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Content="刷新数据" ToolTip.Tip="重新读取全部通道的当前值" />
          <Button Content="保存配方" ToolTip.Tip="保存配方 (Ctrl+S)" />
          <!-- 禁用态的 Tip 默认不弹，可「这个按钮为什么点不了」恰恰是操作员最想问的一句。
               灰按钮不解释自己，人就只能去猜或者去叫工程师。 -->
          <Button Content="下发配方" IsEnabled="False"
                  ToolTip.ShowOnDisabled="True"
                  ToolTip.Tip="设备运行中不能下发，停机后可用" />
        </StackPanel>
        <TextBlock Classes="note" Margin="0"
                   Text="有文字标签的按钮，Tip 补的是「按下去会发生什么」，不是把标签再念一遍。" />

        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="subtle icon" ToolTip.Tip="刷新"><fc:SymbolIcon Symbol="Refresh" /></Button>
          <Button Classes="subtle icon" ToolTip.Tip="保存 (Ctrl+S)"><fc:SymbolIcon Symbol="Save" /></Button>
          <Button Classes="subtle icon" ToolTip.Tip="开始运行"><fc:SymbolIcon Symbol="Play" /></Button>
          <Button Classes="subtle icon" ToolTip.Tip="暂停"><fc:SymbolIcon Symbol="Pause" /></Button>
          <Button Classes="subtle icon" ToolTip.Tip="停止"><fc:SymbolIcon Symbol="Stop" /></Button>
          <Button Classes="subtle icon" ToolTip.Tip="筛选"><fc:SymbolIcon Symbol="Filter" /></Button>
          <TextBlock Classes="note" Margin="12,0,0,0" VerticalAlignment="Center"
                     Text="这一排全靠 Tip 才说得清自己是谁" />
        </StackPanel>

      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="折叠导航的纯图标项、以及所有没有文字标签的图标按钮，必须配 ToolTip。这不是锦上添花，是可用性底线。" />

    <TextBlock Classes="sub" Text="试玩 — 延迟从 400 调到 250" />
    <Border Classes="play">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Slider x:Name="Delay" Width="240" VerticalAlignment="Center"
                  Minimum="0" Maximum="800" Value="400"
                  TickFrequency="50" IsSnapToTickEnabled="True" />
          <TextBlock x:Name="DelayReadout" Classes="note" Margin="0" Width="170"
                     VerticalAlignment="Center" />
          <!-- BetweenShowDelay 设 -1：默认 100ms 内换个控件是立刻弹的，
               那条捷径会把这根滑杆调的东西整个盖掉，试玩就白试了。 -->
          <Button x:Name="DelayTarget" Content="悬停这里"
                  ToolTip.BetweenShowDelay="-1"
                  ToolTip.Tip="重新读取全部通道的当前值" />
        </StackPanel>
        <TextBlock Classes="note" MaxWidth="700"
                   Text="400ms 是桌面惯例：鼠标横穿一排工具按钮时不该一路弹提示。工业界面上手是奔着目标去的，缩到 250ms 更跟手；再往下调就成了扫过即弹，提示条自己挡住要点的东西。调到 0 试试就知道为什么不能没有延迟。" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="写法就是 &lt;Button ToolTip.Tip=&quot;刷新数据&quot; /&gt;，挂在任何 Control 上都行。延迟用 ToolTip.ShowDelay（默认 400ms，工业界面可缩到 250ms）。另一半是 BetweenShowDelay（默认 100ms）：刚弹过一条，这段时间内进相邻控件会跳过延迟直接弹——量延迟、或者不想让工具栏连着弹的时候设成 -1。底走的是亚克力那一档，嵌入式 Linux 上跟 Flyout 一起换实色。">
      <g:MapRow Key="控件" Value="ToolTip.Tip 附加属性；ToolTip 本身进可视树时就是个提示条外观的 ContentControl（上面那三条就是这么摆的）" />
      <g:MapRow Key="附加属性" Value="ToolTip.Tip · ShowDelay=400 · BetweenShowDelay=100 · Placement · HorizontalOffset / VerticalOffset · ShowOnDisabled · ServiceEnabled" />
      <g:MapRow Key="资源键" Value="WinUI 的 ToolTipBackground / ToolTipBorderBrush / ToolTipBorderThemeThickness 在本库落到 AcrylicBackgroundFillColorDefaultBrush + SurfaceStrokeColorFlyoutBrush（底和边成对）· ControlBorderThickness · ControlCornerRadius —— 4px，弹出层里唯一不走 OverlayCornerRadius 的" />
      <g:MapRow Key="阴影" Value="BoxShadow=&quot;0 4 8 0 #24000000, 0 0 2 0 #1F000000&quot;（shadow-tooltip，比 Flyout 的 0 8 16 浅一档——它离页面更近）" />
      <g:MapRow Key="伪类" Value=":open —— 控件自带的开合机制，主题只拿它做 167ms 淡入，不做位移" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
