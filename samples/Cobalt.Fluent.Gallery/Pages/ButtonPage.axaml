<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             x:Class="Cobalt.Fluent.Gallery.Pages.ButtonPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="Button" />
      <Border Classes="tag"><TextBlock Text="2 · 基础输入" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="高 32 · 最小宽 64 · 内边距 11,5,11,6（上下不对称，补偿 Segoe 基线）。底边比其余三边深一档，按下时底边变平——这是最能决定「像不像原生」的细节。" />

    <TextBlock Classes="sub" Text="Standard — 状态矩阵" />
    <g:SpecMatrix>
      <g:SpecMatrix.Sample>
        <DataTemplate><Button Content="保存" /></DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>

    <TextBlock Classes="sub" Text="Accent — 一屏只能有一个" />
    <g:SpecMatrix>
      <g:SpecMatrix.Sample>
        <DataTemplate><Button Classes="accent" Content="开始运行" /></DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>

    <TextBlock Classes="sub" Text="Subtle — 工具栏 / 图标按钮" />
    <g:SpecMatrix States="rest,pointerover,pressed,disabled">
      <g:SpecMatrix.Sample>
        <DataTemplate><Button Classes="subtle" Content="刷新" /></DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>

    <TextBlock Classes="sub" Text="试玩" />
    <Border Classes="play">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="accent" Content="保存并提示" />
          <Button Content="触发失败提示" />
          <Button Classes="subtle" Content="刷新" />
        </StackPanel>
        <TextBlock Classes="note"
                   Text="按住任意按钮体会 :pressed 时底边从 2 色变 1 色的「按平」效果。右上角「动效 0.25×」可以慢放看清 83ms 里发生了什么。" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="底边渐变描边用 ControlElevationBorderBrush（上浅下深的 LinearGradientBrush），accent 版用 AccentControlElevationBorderBrush，不用自己拼上下两档描边色。">
      <g:MapRow Key="控件" Value="Button · RepeatButton · HyperlinkButton" />
      <g:MapRow Key="Classes" Value="accent · subtle · icon" />
      <g:MapRow Key="资源键" Value="ControlFillColorDefault/Secondary/TertiaryBrush · ControlElevationBorderBrush · AccentFillColorDefault/Secondary/TertiaryBrush · TextOnAccentFillColorPrimaryBrush" />
      <g:MapRow Key="Template" Value="ContentPresenter 单层，状态全部走 Setter" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
