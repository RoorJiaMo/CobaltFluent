<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.TreeViewPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="TreeView" />
      <Border Classes="tag"><TextBlock Text="4 · 集合" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="项高 32（比 ListBox 矮），每级缩进 16px。展开箭头 24×24 在最左，旋转 90°，叶节点位置留空但不显示箭头——否则同级文字会对不齐。" />

    <TextBlock Classes="sub" Text="设备树 — 机台 → 通道 → 传感器" />
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <TreeView Width="320">
          <TreeViewItem IsExpanded="True">
            <TreeViewItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fc:SymbolIcon Symbol="Sort" VerticalAlignment="Center" />
                <TextBlock Text="PES-4CH" VerticalAlignment="Center" />
              </StackPanel>
            </TreeViewItem.Header>

            <TreeViewItem IsExpanded="True">
              <TreeViewItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <fc:SymbolIcon Symbol="Tune" VerticalAlignment="Center" />
                  <TextBlock Text="通道 1" VerticalAlignment="Center" />
                </StackPanel>
              </TreeViewItem.Header>

              <TreeViewItem IsSelected="True">
                <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fc:SymbolIcon Symbol="Pulse" VerticalAlignment="Center" />
                    <TextBlock Text="温度" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeViewItem.Header>
              </TreeViewItem>

              <TreeViewItem>
                <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fc:SymbolIcon Symbol="Pulse" VerticalAlignment="Center" />
                    <TextBlock Text="搅拌" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeViewItem.Header>
              </TreeViewItem>
            </TreeViewItem>

            <TreeViewItem>
              <TreeViewItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <fc:SymbolIcon Symbol="Tune" VerticalAlignment="Center" />
                  <TextBlock Text="通道 2" VerticalAlignment="Center" />
                </StackPanel>
              </TreeViewItem.Header>
              <TreeViewItem Header="温度" />
              <TreeViewItem Header="压力" />
            </TreeViewItem>

            <!-- 未接线的通道整行禁用而不是从树里删掉：接线图上它确实存在，
                 删了现场会以为是软件漏了一路。 -->
            <TreeViewItem IsEnabled="False">
              <TreeViewItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <fc:SymbolIcon Symbol="Tune" VerticalAlignment="Center" />
                  <TextBlock Text="通道 3（未接入）" VerticalAlignment="Center" />
                </StackPanel>
              </TreeViewItem.Header>
              <TreeViewItem Header="温度" />
            </TreeViewItem>
          </TreeViewItem>
        </TreeView>

        <TextBlock Classes="note" MaxWidth="700"
                   Text="选中的「温度」在第三层，指示条仍然是 3×16 贴在整行最左——它压在行的左边缘上，不跟着缩进走，和 ListBoxItem / NavigationViewItem / ComboBoxItem 是同一根。缩进只作用在箭头和文字上。" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="状态 — hover 和选中同一档底色，靠指示条区分" />
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <!-- 这一排没用 g:SpecMatrix：TreeViewItem 离开 TreeView 后 Level 会算成 -2，
             模板算出来的缩进变成负数，整行往左跑。所以每格自带一棵单节点的树。 -->
        <StackPanel Orientation="Horizontal" Spacing="24">
          <StackPanel Spacing="8">
            <TreeView Width="180"><TreeViewItem Header="温度" /></TreeView>
            <TextBlock Classes="note" Text="rest" />
          </StackPanel>
          <StackPanel Spacing="8">
            <TreeView Width="180"><TreeViewItem x:Name="HoverSample" Header="温度" /></TreeView>
            <TextBlock Classes="note" Text=":pointerover" />
          </StackPanel>
          <StackPanel Spacing="8">
            <TreeView Width="180"><TreeViewItem Header="温度" IsSelected="True" /></TreeView>
            <TextBlock Classes="note" Text=":selected" />
          </StackPanel>
          <StackPanel Spacing="8">
            <TreeView Width="180"><TreeViewItem Header="温度" IsEnabled="False" IsSelected="True" /></TreeView>
            <TextBlock Classes="note" Text=":disabled" />
          </StackPanel>
        </StackPanel>

        <TextBlock Classes="note" MaxWidth="700"
                   Text="选中行不再吃 hover 底，否则指针扫过一列选中项时整片都在闪。禁用那格顺手带上选中，让指示条也走一次禁用色——禁用不是只把文字调灰。:pressed 没有单独一档：树里按下去就是选中，中间那一帧没有信息量。聚焦框走 FocusAdorner，只圈 PART_LayoutRoot 那一行；展开着的节点不会把整棵子树一起圈进去。" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="缩进与箭头 — 层级由模板按 Level 算" />
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <TreeView Width="320">
          <TreeViewItem IsExpanded="True">
            <TreeViewItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fc:SymbolIcon Symbol="Sort" VerticalAlignment="Center" />
                <TextBlock Text="PES-4CH" VerticalAlignment="Center" />
              </StackPanel>
            </TreeViewItem.Header>

            <TreeViewItem IsExpanded="True">
              <TreeViewItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <fc:SymbolIcon Symbol="Tune" VerticalAlignment="Center" />
                  <TextBlock Text="通道 1" VerticalAlignment="Center" />
                </StackPanel>
              </TreeViewItem.Header>

              <TreeViewItem IsExpanded="True">
                <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fc:SymbolIcon Symbol="Pulse" VerticalAlignment="Center" />
                    <TextBlock Text="温度" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeViewItem.Header>
                <TreeViewItem Header="探头 PT100-A" />
                <TreeViewItem Header="探头 PT100-B" />
              </TreeViewItem>

              <TreeViewItem Header="搅拌" />
            </TreeViewItem>
          </TreeViewItem>
        </TreeView>

        <TextBlock Classes="note" MaxWidth="700"
                   Text="四级 = 0 / 16 / 32 / 48，一路是模板拿 TreeViewItem.Level 乘 16 算出来的，任意深度自动成立。「搅拌」是叶子，箭头那 24px 留着不画，所以它和同级的「温度」文字起点对齐——箭头真收起来的话这一行会整体左移 24。" />
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="试玩 — 展开 / 收起 / 选中路径" />
    <Border Classes="play">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="24">
          <TreeView x:Name="PlayTree" Width="320" Height="260">
            <TreeViewItem Tag="PES-4CH" IsExpanded="True">
              <TreeViewItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <fc:SymbolIcon Symbol="Sort" VerticalAlignment="Center" />
                  <TextBlock Text="PES-4CH" VerticalAlignment="Center" />
                </StackPanel>
              </TreeViewItem.Header>

              <TreeViewItem Tag="通道 1" IsExpanded="True">
                <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fc:SymbolIcon Symbol="Tune" VerticalAlignment="Center" />
                    <TextBlock Text="通道 1" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeViewItem.Header>
                <TreeViewItem Tag="温度 TT-101" Header="温度 TT-101" IsSelected="True" />
                <TreeViewItem Tag="压力 PT-101" Header="压力 PT-101" />
                <TreeViewItem Tag="搅拌 AG-101" Header="搅拌 AG-101" />
              </TreeViewItem>

              <TreeViewItem Tag="通道 2">
                <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fc:SymbolIcon Symbol="Tune" VerticalAlignment="Center" />
                    <TextBlock Text="通道 2" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeViewItem.Header>
                <TreeViewItem Tag="温度 TT-201" Header="温度 TT-201" />
                <TreeViewItem Tag="压力 PT-201" Header="压力 PT-201" />
              </TreeViewItem>

              <TreeViewItem Tag="通道 3（未接入）" IsEnabled="False">
                <TreeViewItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fc:SymbolIcon Symbol="Tune" VerticalAlignment="Center" />
                    <TextBlock Text="通道 3（未接入）" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeViewItem.Header>
                <TreeViewItem Tag="温度 TT-301" Header="温度 TT-301" />
              </TreeViewItem>
            </TreeViewItem>
          </TreeView>

          <StackPanel Spacing="8" Width="280" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ExpandAll" Content="全部展开" />
              <Button x:Name="CollapseAll" Content="全部收起" />
            </StackPanel>
            <TextBlock x:Name="PathText" TextWrapping="Wrap" Text="选中路径：（未选）" />
            <TextBlock Classes="note"
                       Text="点节点选中，点箭头只展开不选中——两件事分开，工程师展开一路找传感器时不会顺手把当前选中项换掉。方向键 ← → 也能收展当前行。" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <g:MapBlock Note="缩进由模板的 Margin 按 Level 算，别一层一个写死的类——那样只能撑到你写到的那一层。展开态没有 :expanded 伪类可用——11.3 的 TreeViewItem 只有 :pressed / :selected / :empty，箭头那 90° 挂在 PART_ExpandCollapseChevron 的 IsChecked 上（和 IsExpanded 双向绑，等价）。叶子的箭头用 Opacity=0 而不是 IsVisible=False：那 24px 一塌，同级文字就对不齐。">
      <g:MapRow Key="控件" Value="TreeView · TreeViewItem（层级数据走 TreeDataTemplate，大表走 HierarchicalTreeDataGridSource）" />
      <g:MapRow Key="缩进" Value="PART_Header.Margin ← TreeViewItem.Level × 16（MarginMultiplierConverter，Left=True）" />
      <g:MapRow Key="选择器" Value="TreeViewItem:selected（指示条）· TreeViewItem:pointerover:not(:selected)· TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron（叶子，留位不画）· ToggleButton#PART_ExpandCollapseChevron:checked（展开转 90°）" />
      <g:MapRow Key="资源键" Value="SubtleFillColorSecondaryBrush（hover / selected 底）· AccentFillColorDefaultBrush（指示条）· TextFillColorSecondaryBrush（箭头）· TextFillColorDisabledBrush（禁用）" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
