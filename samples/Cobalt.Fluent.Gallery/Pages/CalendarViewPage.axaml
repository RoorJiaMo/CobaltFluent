<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.CalendarViewPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="CalendarView / DateRange" />
      <Border Classes="tag"><TextBlock Text="8 · 日期时间" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="日期格 36px 圆形。今天=accent 描边，选中=accent 实心，非本月=tertiary。「有记录的日子」以底部小圆点标记——工业界面查询历史批次时，该标记直接指示有数据的日期，避免一次无效查询。" />

    <TextBlock Classes="sub" Text="日期格 — 状态矩阵" />
    <!-- CalendarDayButton 单独立起来也吃 ControlTheme，所以这里能把一格一格的规格
         摊开看。整台日历一次只能同时呈现其中几个态，当不了规格。 -->
    <g:SpecMatrix States="rest,pointerover,pressed,today,selected,inactive,blackout,focus"
                  CellSpacing="20">
      <g:SpecMatrix.Sample>
        <DataTemplate><CalendarDayButton Content="20" /></DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>
    <TextBlock Classes="note"
               Text=":today 为 1px accent 内描边，:selected 为 accent 实底。两者同时命中时以选中态优先、today 描边收起——实心填充上叠加同色描边会降低视觉清晰度。:inactive（相邻月）与 :blackout（禁选日）均仅弱化文字色，格子形状保持不变，否则同一屏日历中会出现多种不同的外形。" />

    <TextBlock Classes="sub" Text="月视图 — SelectionMode=SingleRange" />
    <Border Classes="panel">
      <fc:RangeCalendar x:Name="SpecCalendar" FirstDayOfWeek="Monday" />
    </Border>
    <TextBlock Classes="note"
               Text="区间设定为「今天之前两天至今天」，今天既是区间末端又是 :today；今天之后整段禁选——查询历史批次时未来日期不存在数据，故直接禁用。日期不固定在特定年月，无论展柜何时打开，:today 均出现在正确的位置。" />
    <TextBlock Classes="note"
               Text="未来日期通过 BlackoutDates 禁用，而非 DisplayDateEnd。后者按「年月」粒度比较，无法限制本月剩余的日期，只会使整个月一并不可见。DisplayDateStart/End 控制可翻页到的月份范围，BlackoutDates 才控制单日是否可选。" />

    <TextBlock Classes="sub" Text="DateRangePicker — 两个 CalendarDatePicker 以「至」连接" />
    <Border Classes="panel">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- 日期格式钉成 yyyy-MM-dd：查批次要拿这个字符串去和工单、日志对，
               跟着系统区域走的话换台机器就成了 8/20/2026。 -->
          <CalendarDatePicker x:Name="RangeFrom"
                              Watermark="起始日期"
                              SelectedDateFormat="Custom"
                              CustomDateFormatString="yyyy-MM-dd"
                              MinWidth="160" />
          <TextBlock Text="至" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <CalendarDatePicker x:Name="RangeTo"
                              Watermark="结束日期"
                              SelectedDateFormat="Custom"
                              CustomDateFormatString="yyyy-MM-dd"
                              MinWidth="160" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="PresetToday" Classes="subtle" Content="今天" />
          <Button x:Name="Preset7" Classes="subtle" Content="近 7 天" />
          <Button x:Name="Preset30" Classes="subtle" Content="近 30 天" />
          <Button x:Name="PresetBatch" Classes="subtle" Content="本批次" />
        </StackPanel>

        <TextBlock x:Name="RangeEcho" Theme="{StaticResource BodyStrongTextBlockStyle}" />
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="两个选择器互相约束可选范围：选定起点后，终点侧日历无法翻页到起点之前；反之亦然。倒序区间在业务上没有意义，与其等待查询返回「结束早于开始」的错误，不如使该选择在日历层面不可达。经键盘直接输入的日期不受日历层限制，代码中另有兜底处理——出现倒序时将另一端同步跟随，不弹出提示。" />
    <TextBlock Classes="note"
               Text="快捷预设按钮不带选中态——它们是「跳转到该时间窗」的动作，执行后区间仍可手动微调，常亮的选中态会被误读为区间已锁定。若需要明确显示「当前使用的时间窗」，应改用 SegmentedControl——互斥单选正是其语义。" />
    <TextBlock Classes="note"
               Text="「本批次」在本页固定为最近三天。实际产线上该窗口应取自当前选中的批次记录，且整组预设应可配置——连续生产线关注近 24 小时，小批量生产关注上一批次至本批次。" />

    <TextBlock Classes="sub" Text="交互演示 — 单击选定起点日期，再次单击选定终点日期" />
    <Border Classes="play">
      <StackPanel Orientation="Horizontal" Spacing="24">
        <fc:RangeCalendar x:Name="PlayCalendar" FirstDayOfWeek="Monday" />
        <StackPanel Spacing="12" MaxWidth="320" VerticalAlignment="Top">
          <TextBlock x:Name="PlayEcho" TextWrapping="Wrap"
                     Theme="{StaticResource BodyStrongTextBlockStyle}" />
          <Button x:Name="PlayClear" Classes="subtle" Content="清空" HorizontalAlignment="Left" />
          <TextBlock Classes="note" Margin="0"
                     Text="按住并拖动同样可一次划定区间，与 Win11 行为一致。第三次点击不是「扩大区间」，而是开始新的一段——SingleRange 仅保留一段，无需先清除既有选择即可直接开始新的区间。" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="区间中段以方角连接成连续条带，仅首尾各保留一侧圆角——区间内逐日绘制独立圆形选中态时，视觉上呈断续排列，无法传达区间的连续性。Avalonia 的 Calendar 在 SingleRange 下仅把区间内每一天标记为 :selected，不提供首尾信息，因此本页两个日历均为 fc:RangeCalendar：它依据 SelectedDates 的首尾补充 :rangestart / :inrange / :rangeend 三个伪类，样式挂接在 CalendarDayButton 的 ControlTheme 上。" />
    <TextBlock Classes="note"
               Text="首尾两天保留 accent 实底和 text-on-accent，中段使用 subtle-hover 底色 + 常规文字色——中段并非「也被选中」，而是「被区间覆盖」，两种状态在视觉上必须可区分。区间缩减为单日时三个伪类全部移除，恢复为原本的圆形。格与格之间 2px 的缝隙来自网格本身的间距（每格 Margin 1，各承担一半），中段因此呈断续条带，不另做补偿。" />

    <g:MapBlock Note="「有记录的日子」的小圆点需要自定义 CalendarDayButton 的 ControlTheme，在模板中加入一个 Ellipse 并绑定 :marked，本页未实现——Avalonia 的 Calendar 不支持 MarkedDates，日期集合也需一并自行实现。区间的首尾半圆 / 中段方角已由 fc:RangeCalendar 提供。快捷预设按钮建议实现为可配置——不同产线关注的时间窗不同。">
      <g:MapRow Key="控件" Value="Calendar · CalendarItem · CalendarDayButton · CalendarButton（年 / 十年视图）——均为 Avalonia 内置；fc:RangeCalendar 是 Calendar 的子类，仅补充区间伪类，沿用同一套 ControlTheme；DateRangePicker 无内置实现，由两个 CalendarDatePicker 组合" />
      <g:MapRow Key="属性" Value="SelectionMode:{None,SingleDate,SingleRange,MultipleRange}（并非 Range）· SelectedDate · SelectedDates.AddRange(start,end) · BlackoutDates:CalendarDateRange 集合 · DisplayDate · DisplayDateStart/End（按年月粒度比较，限制翻页而非单日）· FirstDayOfWeek · IsTodayHighlighted · DisplayMode:{Month,Year,Decade}" />
      <g:MapRow Key="伪类" Value=":today · :selected · :inactive（相邻月）· :blackout（禁选日）· :pointerover · :pressed · :disabled — 以上为内置；:rangestart :inrange :rangeend 由 fc:RangeCalendar 补充；「有记录的日子」的 :marked 尚未实现" />
      <g:MapRow Key="资源键" Value="CalendarDayButtonSize=36 · CalendarDayButtonCornerRadius=18（圆形）· AccentFillColorDefaultBrush（today 描边 / selected 实底）· TextOnAccentFillColorPrimaryBrush（选中日文字）· TextFillColorTertiaryBrush（相邻月）· TextFillColorDisabledBrush（禁选日）· TabularNumbers（日期数字等宽，否则网格中两位数字无法对齐）" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
