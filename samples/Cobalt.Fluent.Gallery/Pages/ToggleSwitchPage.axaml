<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             x:Class="Cobalt.Fluent.Gallery.Pages.ToggleSwitchPage">

  <StackPanel HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="ToggleSwitch" />
      <Border Classes="tag"><TextBlock Text="2 · 基础输入" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="轨道 40×20，拇指 12×12。标志性交互特征是拇指拉伸：按下时宽度从 12 拉伸至 17，位移过渡 167ms。与 CheckBox 的区别在于语义——开关立即生效，复选框需等待提交。" />

    <TextBlock Classes="sub" Text="off" />
    <g:SpecMatrix>
      <g:SpecMatrix.Sample>
        <DataTemplate><ToggleSwitch Content="自动保存" /></DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>

    <TextBlock Classes="sub" Text="on" />
    <g:SpecMatrix States="checked,pointerover,pressed,disabled,focus">
      <g:SpecMatrix.Sample>
        <DataTemplate><ToggleSwitch Content="自动保存" IsChecked="True" /></DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>

    <TextBlock Classes="sub" Text="交互演示 — 放慢观察 167ms 的动画过程" />
    <Border Classes="play">
      <StackPanel Spacing="12">
        <ToggleSwitch Content="自动保存" OnContent="开" OffContent="关" />
        <ToggleSwitch Content="趋势记录" IsChecked="True" OnContent="记录中" OffContent="已停止" />
        <TextBlock Classes="note" MaxWidth="700"
                   Text="按住时拇指被拉长，松开后拇指滑动至另一端。右上角「动效 0.25×」将 167ms 放慢 4 倍。" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="拇指拉伸在模板中通过 Width 动画实现，无需重写 Template 结构。">
      <g:MapRow Key="控件" Value="ToggleSwitch" />
      <g:MapRow Key="属性" Value="OnContent=&quot;开&quot; · OffContent=&quot;关&quot; · Content（标题）" />
      <g:MapRow Key="资源键" Value="ControlAltFillColorSecondaryBrush（off 轨道）· AccentFillColorDefaultBrush（on 轨道）· ControlStrongFillColorDefaultBrush / TextOnAccentFillColorPrimaryBrush（拇指）" />
      <g:MapRow Key="时长" Value="位移 167ms（ControlFastAnimationDuration）· 拇指拉伸 83ms" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
