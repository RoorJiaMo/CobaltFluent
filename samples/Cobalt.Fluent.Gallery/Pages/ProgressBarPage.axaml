<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.ProgressBarPage">

  <StackPanel Spacing="0" HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="ProgressBar" />
      <Border Classes="tag"><TextBlock Text="5 · 反馈" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="高度 3px，药丸圆角。Win11 的进度条比大多数框架细得多——加粗会明显偏离该风格。不确定态是一小段往复移动，而非整条闪烁。" />

    <TextBlock Classes="sub" Text="四种形态" />
    <Border Classes="panel">
      <StackPanel Spacing="18">

        <StackPanel Spacing="6">
          <ProgressBar Width="280" Value="62" />
          <TextBlock Classes="note" Margin="0" Text="determinate 62%" />
        </StackPanel>

        <StackPanel Spacing="6">
          <ProgressBar Width="280" IsIndeterminate="True" />
          <TextBlock Classes="note" Margin="0" Text="indeterminate — 33% 宽的一段，往复周期 2s" />
        </StackPanel>

        <StackPanel Spacing="6">
          <ProgressBar Width="280" Value="62" Classes="paused" />
          <TextBlock Classes="note" Margin="0" Text=".paused — caution" />
        </StackPanel>

        <StackPanel Spacing="6">
          <ProgressBar Width="280" Value="62" Classes="error" />
          <TextBlock Classes="note" Margin="0" Text=".error — critical" />
        </StackPanel>

      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="圆角固定为 1.5，不绑定 ControlCornerRadius：4px 的控件圆角落在 3px 高的条上会切出方角，此处需要完整的圆形端头。槽与条共用同一半径，进度走满时端头才能完全贴合。" />

    <TextBlock Classes="sub" Text="典型用法" />
    <Border Classes="panel">
      <fc:Card Width="360">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="恒温保持" />
            <TextBlock Grid.Column="1"
                       Theme="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontFeatures="{StaticResource TabularNumbers}"
                       VerticalAlignment="Center"
                       Text="742 / 1200 s" />
          </Grid>
          <ProgressBar Value="61.8" />
        </StackPanel>
      </fc:Card>
    </Border>
    <TextBlock Classes="note"
               Text="读数单独成行，不使用 ShowProgressText——文字置入条内会把 3px 撑到一行字高，偏离该控件的形态。数字必须等宽，742→800 仅个别数字变化也会使右边缘横向跳动。" />

    <TextBlock Classes="sub" Text="交互演示 — 含暂停与故障的批次流程" />
    <Border Classes="play">
      <StackPanel Spacing="12">

        <Grid ColumnDefinitions="*,Auto" Width="360">
          <TextBlock Grid.Column="0" Text="恒温保持" />
          <TextBlock Grid.Column="1" x:Name="Elapsed"
                     Theme="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     FontFeatures="{StaticResource TabularNumbers}"
                     VerticalAlignment="Center"
                     Text="0 / 1200 s" />
        </Grid>

        <ProgressBar x:Name="Run" Width="360" Maximum="1200" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="Go" Classes="accent" Content="运行" />
          <Button x:Name="Pause" Content="暂停" />
          <Button x:Name="Fault" Content="模拟故障" />
          <Button x:Name="Reset" Content="复位" />
        </StackPanel>

        <CheckBox x:Name="Indeterminate" Content="切换到不确定态" />

        <TextBlock Classes="note" MaxWidth="700"
                   Text="暂停与故障仅更换颜色，进度不回退——操作员依据停止位置判断流程卡在哪一步，清零等同于抹除现场信息。两态互切经 167ms 的透明度淡入淡出过渡，进度条不发生瞬移。" />

      </StackPanel>
    </Border>

    <g:MapBlock Note="paused / error 在 Avalonia 中没有内置伪类，通过 Classes 切换：ProgressBar.paused / .error，Setter 仅修改 Foreground。仅改这一处即可——确定态与不确定态两个 Indicator 都 TemplateBinding 到 Foreground，相当于将其用作条色插槽。这两档使用主题状态色而非安全色，进度暂停与报警不属于同一类事件。">
      <g:MapRow Key="控件" Value="ProgressBar（Avalonia 内置）" />
      <g:MapRow Key="属性" Value="IsIndeterminate · ShowProgressText / ProgressTextFormat · Value · Minimum / Maximum · Orientation" />
      <g:MapRow Key="Classes" Value="paused（caution）· error（critical）" />
      <g:MapRow Key="伪类" Value=":indeterminate · :horizontal / :vertical（均为 Avalonia 内置，由属性推出）" />
      <g:MapRow Key="资源键" Value="ProgressBarHeight=3 · ProgressBarCornerRadius=1.5 · ProgressBarMinLength=200 · ControlAltFillColorSecondaryBrush（槽）· AccentFillColorDefaultBrush（条）· SystemFillColorCautionBrush · SystemFillColorCriticalBrush" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
