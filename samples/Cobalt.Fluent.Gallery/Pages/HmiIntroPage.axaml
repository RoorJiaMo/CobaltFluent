<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             x:Class="Cobalt.Fluent.Gallery.Pages.HmiIntroPage">

  <StackPanel HorizontalAlignment="Left" MaxWidth="860">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="HMI 专用控件" />
      <Border Classes="tag"><TextBlock Text="7 · 自定义" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="这一组在 WinUI / FluentAvalonia 中均不存在，实现方式与前六组完全不同：前六组为内置控件修改 Setter，这一组从零编写 TemplatedControl + 依赖属性 + 自定义伪类。下文各控件列出的是属性面而非资源键。" />

    <TextBlock Classes="sub" Text="七条硬约束——不属于风格偏好" />
    <Border Classes="panel" HorizontalAlignment="Stretch">
      <StackPanel Spacing="14">
        <StackPanel.Styles>
          <Style Selector="TextBlock.rule">
            <Setter Property="TextWrapping" Value="Wrap" />
          </Style>
          <Style Selector="TextBlock.rule-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
          </Style>
        </StackPanel.Styles>

        <StackPanel>
          <TextBlock Classes="rule-title" Text="1 · 安全色不跟随主题" />
          <TextBlock Classes="rule" Text="急停和 Alarm 级报警用 SafetyRedBrush，不用 SystemFillColorCriticalBrush——后者在深色主题下是浅粉 #FF99A4。ISO 13850 要求红钮黄衬。" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="rule-title" Text="2 · 报警用呼吸不用闪烁" />
          <TextBlock Classes="rule" Text="1.5 秒一个周期，opacity 1↔.62。高频闪烁引发疲劳，且有光敏性癫痫风险。禁用动画后必须用黄色描边补强，否则 Alarm 与 Warning 无法区分。" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="rule-title" Text="3 · JogButton 必须处理 PointerCaptureLost 和 LostFocus" />
          <TextBlock Classes="rule" Text="仅监听 PointerReleased 并不充分——按住后将指针拖出按钮时，释放事件可能不在该控件上触发，设备将持续运动。另需增加看门狗定时器作为最后保障。" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="rule-title" Text="4 · 心跳灯由实际通信事件驱动" />
          <TextBlock Classes="rule" Text="不得以固定周期动画模拟。虚假心跳比没有心跳更危险——通信已断开而指示灯仍在闪动，操作员会误认为系统运行正常。" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="rule-title" Text="5 · :stale 时读数保留最后已知值" />
          <TextBlock Classes="rule" Text="仅变灰 + 标注时间。替换为「—」是错误做法：通信虽已中断，设备上的反应仍在进行，操作员需要知道断开前的最后一个值。" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="rule-title" Text="6 · :dirty 需三重提示" />
          <TextBlock Classes="rule" Text="整行淡黄底 + 输入框底边变色 + 行尾徽章。一屏二十行参数时，仅改动 2px 边框不足以被察觉。" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="rule-title" Text="7 · 软件急停不能替代硬件急停回路" />
          <TextBlock Classes="rule" Text="软件路径需经过 UI 线程、消息队列、通信链路，任何一环阻塞即不响应。建议在界面上同时标注硬件急停的物理位置。" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Classes="sub" Text="建议实现顺序" />
    <TextBlock Classes="lead"
               Text="Readout → StatusIndicator → ParameterRow → AlarmBanner → DeviceStatusBar → JogButton → EStopButton。前三个是纯显示/输入，最容易验证；后两个涉及安全语义，需配合实际设备联调。" />

    <g:MapBlock Note="这四个控件的交互本身即规格，无法仅依据静态图实现：ParameterRow（dirty→writing→clean/failed，成功填回读值而非输入值）、JogButton（多个停止触发点 + 看门狗）、EStopButton（触发自锁，必须复位）、TrendChart（trackball 十字线）。">
      <g:MapRow Key="覆盖" Value="Readout · StatusIndicator · AlarmBanner · ParameterRow · JogButton · EStopButton · DeviceStatusBar（含 Heartbeat / JogGroup / ParameterTable）" />
      <g:MapRow Key="基类" Value="TemplatedControl（JogButton 与 EStopButton 继承 Button，需要按压语义）" />
      <g:MapRow Key="伪类" Value="全部自定义，在属性变化里 PseudoClasses.Set(&quot;:dirty&quot;, v)" />
      <g:MapRow Key="嵌入式" Value="StatusIndicator.IsPulseEnabled · AlarmBanner.IsBreathingEnabled——Mali GPU 上同屏十几个并发动画会掉帧，禁用后用静态形状补强" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
