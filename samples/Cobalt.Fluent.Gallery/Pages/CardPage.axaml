<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:Cobalt.Fluent.Gallery.Infrastructure"
             xmlns:fc="using:Cobalt.Fluent.Controls"
             x:Class="Cobalt.Fluent.Gallery.Pages.CardPage">

  <UserControl.Styles>
    <!-- 试玩区里「当前选中」的描边。选中态不是 Card 的职责——它没有 :selected，
         也不该有：卡片选没选中是列表的事，控件只提供一块底和一圈边。 -->
    <Style Selector="fc|Card.picked">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="0" HorizontalAlignment="Left">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="page-title" Text="Card" />
      <Border Classes="tag"><TextBlock Text="3 · 容器" /></Border>
    </StackPanel>

    <TextBlock Classes="lead"
               Text="4px 圆角（页面内元素，而非 8px），半透明底 + 1px 描边，不加阴影。Card 是 content layer 内部的分区，不属于第三层。" />

    <TextBlock Classes="sub" Text="静态卡片 — 三种状态外观一致，符合预期" />
    <g:SpecMatrix States="rest,pointerover,pressed">
      <g:SpecMatrix.Sample>
        <DataTemplate>
          <fc:Card Width="220">
            <StackPanel Spacing="4">
              <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="反应器 R1" />
              <TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="当前 85.4 °C · 目标 85.0 °C" />
            </StackPanel>
          </fc:Card>
        </DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>
    <TextBlock Classes="note"
               Text="此处伪类为强制附加，底色仍无变化——ControlTheme 中两条状态规则均以 :clickable 为前置条件。为不可点击的元素添加悬停反馈，会导致操作员反复点击，并将其作为「卡死」类故障上报。" />

    <TextBlock Classes="sub" Text="IsClickable=True — 启用后才响应指针" />
    <g:SpecMatrix States="rest,pointerover,pressed">
      <g:SpecMatrix.Sample>
        <DataTemplate>
          <fc:Card Width="220" IsClickable="True">
            <StackPanel Spacing="4">
              <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="反应器 R2" />
              <TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="当前 24.1 °C · 待机" />
            </StackPanel>
          </fc:Card>
        </DataTemplate>
      </g:SpecMatrix.Sample>
    </g:SpecMatrix>
    <TextBlock Classes="note"
               Text="悬停态底色仅相差不到 8% 的半透明白，高对比度主题下该差别完全消失。因此可点击卡片必须依靠 1px 描边传达可交互性，不应仅凭背景色区分「能否点击」。" />

    <TextBlock Classes="sub" Text="成组 — content layer 内部的分区" />
    <Border Classes="panel">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <fc:Card Width="200">
          <StackPanel Spacing="4">
            <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="反应器 R1" />
            <TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="当前 85.4 °C · 目标 85.0 °C" />
          </StackPanel>
        </fc:Card>
        <fc:Card Width="200">
          <StackPanel Spacing="4">
            <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="反应器 R2" />
            <TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="当前 24.1 °C · 待机" />
          </StackPanel>
        </fc:Card>
        <fc:Card Width="200">
          <StackPanel Spacing="4">
            <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="反应器 R3" />
            <TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="当前 —— · 未连接" />
          </StackPanel>
        </fc:Card>
      </StackPanel>
    </Border>
    <TextBlock Classes="note"
               Text="卡片位于 content layer 之上，以描边和半透明底划分区域，不再叠加阴影——阴影仅保留给真正处于浮层的 ToolTip / Flyout / ContentDialog。若页面内元素也添加阴影，整屏元素都会呈现悬浮外观。" />

    <TextBlock Classes="sub" Text="交互演示 — 关闭 IsClickable 后反馈随之消失" />
    <Border Classes="play">
      <StackPanel Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <fc:Card x:Name="PlayR1" Width="180" IsClickable="True" Tag="反应器 R1">
            <StackPanel Spacing="4">
              <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="反应器 R1" />
              <TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="85.4 °C · 运行" />
            </StackPanel>
          </fc:Card>
          <fc:Card x:Name="PlayR2" Width="180" IsClickable="True" Tag="反应器 R2">
            <StackPanel Spacing="4">
              <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="反应器 R2" />
              <TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="24.1 °C · 待机" />
            </StackPanel>
          </fc:Card>
          <fc:Card x:Name="PlayR3" Width="180" IsClickable="True" Tag="反应器 R3">
            <StackPanel Spacing="4">
              <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="反应器 R3" />
              <TextBlock Theme="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="—— · 未连接" />
            </StackPanel>
          </fc:Card>
        </StackPanel>

        <ToggleSwitch x:Name="ClickableSwitch"
                      Content="IsClickable"
                      OnContent="True" OffContent="False"
                      IsChecked="True" />

        <TextBlock x:Name="PlayLog" Classes="note" Margin="0"
                   Text="可对任意卡片执行悬停、按下与点击操作。" />
      </StackPanel>
    </Border>

    <g:MapBlock Note="可点击卡片在高对比度下必须具备可见描边，否则操作员无法识别其可点击性；不应仅以背景色区分。IsClickable 仅控制视觉反馈，点击行为需由使用方自行订阅 Tapped——两者不同步时会出现「有反馈但无响应」或「有响应但无反馈」，这两种情况都会被操作员作为故障上报。">
      <g:MapRow Key="控件" Value="fc:Card : ContentControl —— 静态与可点击两种形态合并为同一控件，由 IsClickable 切换" />
      <g:MapRow Key="属性" Value="IsClickable · Content · Padding=16（默认）" />
      <g:MapRow Key="伪类" Value=":clickable（IsClickable=True）。状态规则均写作 ^:clickable:pointerover / ^:clickable:pressed，静态卡片因而没有指针反馈" />
      <g:MapRow Key="资源键" Value="CardBackgroundFillColorDefaultBrush · CardBackgroundFillColorSecondaryBrush（:pointerover）· ControlFillColorTertiaryBrush（:pressed）· CardStrokeColorDefaultBrush · ControlCornerRadius" />
    </g:MapBlock>

  </StackPanel>
</UserControl>
