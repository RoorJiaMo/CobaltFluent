<!-- 本文件由 tools/gen_tokens.py 从 tools/palette.json 生成，不要手改。 -->
<!-- 改颜色请改 palette.json，然后重跑：python3 tools/gen_tokens.py       -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fc="using:Cobalt.Fluent">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- 文字 -->
      <Color x:Key="TextFillColorPrimary">#E4000000</Color>
      <Color x:Key="TextFillColorSecondary">#9E000000</Color>
      <Color x:Key="TextFillColorTertiary">#72000000</Color>
      <Color x:Key="TextFillColorDisabled">#5C000000</Color>
      <Color x:Key="TextFillColorStale">#8A000000</Color>
      <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFFFF</Color>
      <Color x:Key="TextOnAccentFillColorSecondary">#B2FFFFFF</Color>
      <Color x:Key="AccentTextFillColorPrimary">#FF003E92</Color>
      <!-- 表面与层 -->
      <Color x:Key="SolidBackgroundFillColorBase">#FFF3F3F3</Color>
      <Color x:Key="SolidBackgroundFillColorSecondary">#FFEEEEEE</Color>
      <Color x:Key="SolidBackgroundFillColorTertiary">#FFF9F9F9</Color>
      <Color x:Key="SolidBackgroundFillColorQuarternary">#FFFFFFFF</Color>
      <Color x:Key="LayerFillColorDefault">#80FFFFFF</Color>
      <Color x:Key="LayerFillColorAlt">#FFFFFFFF</Color>
      <Color x:Key="CardBackgroundFillColorDefault">#B2FFFFFF</Color>
      <Color x:Key="CardBackgroundFillColorSecondary">#80F6F6F6</Color>
      <Color x:Key="SmokeFillColorDefault">#4C000000</Color>
      <Color x:Key="AcrylicBackgroundFillColorDefault">#D9FCFCFC</Color>
      <!-- 控件填充 -->
      <Color x:Key="ControlFillColorDefault">#B2FFFFFF</Color>
      <Color x:Key="ControlFillColorSecondary">#80F9F9F9</Color>
      <Color x:Key="ControlFillColorTertiary">#4CF9F9F9</Color>
      <Color x:Key="ControlFillColorDisabled">#4CF9F9F9</Color>
      <Color x:Key="ControlFillColorInputActive">#FFFFFFFF</Color>
      <Color x:Key="ControlStrongFillColorDefault">#72000000</Color>
      <Color x:Key="ControlStrongFillColorDisabled">#51000000</Color>
      <Color x:Key="ControlSolidFillColorDefault">#FFFFFFFF</Color>
      <Color x:Key="ControlAltFillColorSecondary">#06000000</Color>
      <Color x:Key="ControlAltFillColorTertiary">#0F000000</Color>
      <Color x:Key="ControlAltFillColorQuarternary">#18000000</Color>
      <!-- Subtle -->
      <Color x:Key="SubtleFillColorSecondary">#09000000</Color>
      <Color x:Key="SubtleFillColorTertiary">#06000000</Color>
      <!-- 强调 -->
      <Color x:Key="AccentFillColorDefault">#FF0067C0</Color>
      <Color x:Key="AccentFillColorSecondary">#E60067C0</Color>
      <Color x:Key="AccentFillColorTertiary">#CC0067C0</Color>
      <Color x:Key="AccentFillColorDisabled">#37000000</Color>
      <!-- 描边 -->
      <Color x:Key="ControlStrokeColorDefault">#0F000000</Color>
      <Color x:Key="ControlStrokeColorSecondary">#29000000</Color>
      <Color x:Key="ControlStrokeColorOnAccentDefault">#14FFFFFF</Color>
      <Color x:Key="ControlStrokeColorOnAccentSecondary">#66000000</Color>
      <Color x:Key="ControlStrongStrokeColorDefault">#72000000</Color>
      <Color x:Key="CardStrokeColorDefault">#0F000000</Color>
      <Color x:Key="SurfaceStrokeColorDefault">#66757575</Color>
      <Color x:Key="SurfaceStrokeColorFlyout">#0F000000</Color>
      <Color x:Key="DividerStrokeColorDefault">#0F000000</Color>
      <Color x:Key="FocusStrokeColorOuter">#E4000000</Color>
      <Color x:Key="FocusStrokeColorInner">#B2FFFFFF</Color>
      <!-- 状态 -->
      <Color x:Key="SystemFillColorSuccess">#FF0F7B0F</Color>
      <Color x:Key="SystemFillColorCaution">#FF9D5D00</Color>
      <Color x:Key="SystemFillColorCritical">#FFC42B1C</Color>
      <Color x:Key="SystemFillColorNeutral">#FF8A8A8A</Color>
      <Color x:Key="SystemFillColorSuccessBackground">#FFDFF6DD</Color>
      <Color x:Key="SystemFillColorCautionBackground">#FFFFF4CE</Color>
      <Color x:Key="SystemFillColorCriticalBackground">#FFFDE7E9</Color>
      <Color x:Key="SystemFillColorAttentionBackground">#80F6F6F6</Color>
      <!-- 图表色板 -->
      <Color x:Key="ChartSeries1">#FF0078D4</Color>
      <Color x:Key="ChartSeries2">#FFCA5010</Color>
      <Color x:Key="ChartSeries3">#FF038387</Color>
      <Color x:Key="ChartSeries4">#FF8764B8</Color>
      <Color x:Key="ChartSeries5">#FFC239B3</Color>
      <Color x:Key="ChartSeries6">#FF986F0B</Color>
      <Color x:Key="ChartSeries7">#FF4F6BED</Color>
      <Color x:Key="ChartSeries8">#FF4A6572</Color>
      <Color x:Key="ChartGridLine">#0F000000</Color>
      <Color x:Key="ChartAxisLine">#72000000</Color>
      <Color x:Key="ChartBand">#09000000</Color>
      <!-- 安全色 -->
      <Color x:Key="SafetyRed">#FFC42B1C</Color>
      <Color x:Key="SafetyRedHigh">#FFE81123</Color>
      <Color x:Key="SafetyYellow">#FFFFDD00</Color>
      <Color x:Key="TextOnSafetyFillColorPrimary">#FFFFFFFF</Color>
      <Color x:Key="TextOnSafetyYellowFillColorPrimary">#FF000000</Color>
      <Color x:Key="SafetyOverlayFillColorDefault">#29FFFFFF</Color>
      <Color x:Key="SafetyOverlayFillColorSecondary">#42FFFFFF</Color>
      <Color x:Key="SafetyOverlayStrokeColorDefault">#3DFFFFFF</Color>
      <Color x:Key="SafetyOverlayShadeColorDefault">#3D000000</Color>
      <!-- 强调色梯（Win11 的 accent palette） -->
      <Color x:Key="SystemAccentColor">#FF0078D4</Color>
      <Color x:Key="SystemAccentColorLight1">#FF0091F8</Color>
      <Color x:Key="SystemAccentColorLight2">#FF4CC2FF</Color>
      <Color x:Key="SystemAccentColorLight3">#FF99EBFF</Color>
      <Color x:Key="SystemAccentColorDark1">#FF0067C0</Color>
      <Color x:Key="SystemAccentColorDark2">#FF003E92</Color>
      <Color x:Key="SystemAccentColorDark3">#FF001A68</Color>

      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
