      <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{StaticResource SystemFillColorCautionBackground}" />
      <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{StaticResource SystemFillColorCriticalBackground}" />
      <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
      <SolidColorBrush x:Key="ChartSeries1Brush" Color="{StaticResource ChartSeries1}" />
      <SolidColorBrush x:Key="ChartSeries2Brush" Color="{StaticResource ChartSeries2}" />
      <SolidColorBrush x:Key="ChartSeries3Brush" Color="{StaticResource ChartSeries3}" />
      <SolidColorBrush x:Key="ChartSeries4Brush" Color="{StaticResource ChartSeries4}" />
      <SolidColorBrush x:Key="ChartSeries5Brush" Color="{StaticResource ChartSeries5}" />
      <SolidColorBrush x:Key="ChartSeries6Brush" Color="{StaticResource ChartSeries6}" />
      <SolidColorBrush x:Key="ChartSeries7Brush" Color="{StaticResource ChartSeries7}" />
      <SolidColorBrush x:Key="ChartSeries8Brush" Color="{StaticResource ChartSeries8}" />
      <SolidColorBrush x:Key="ChartGridLineBrush" Color="{StaticResource ChartGridLine}" />
      <SolidColorBrush x:Key="ChartAxisLineBrush" Color="{StaticResource ChartAxisLine}" />
      <SolidColorBrush x:Key="ChartBandBrush" Color="{StaticResource ChartBand}" />
      <SolidColorBrush x:Key="SafetyRedBrush" Color="{StaticResource SafetyRed}" />
      <SolidColorBrush x:Key="SafetyRedHighBrush" Color="{StaticResource SafetyRedHigh}" />
      <SolidColorBrush x:Key="SafetyYellowBrush" Color="{StaticResource SafetyYellow}" />
      <SolidColorBrush x:Key="TextOnSafetyFillColorPrimaryBrush" Color="{StaticResource TextOnSafetyFillColorPrimary}" />
      <SolidColorBrush x:Key="SafetyOverlayFillColorDefaultBrush" Color="{StaticResource SafetyOverlayFillColorDefault}" />
      <SolidColorBrush x:Key="SafetyOverlayFillColorSecondaryBrush" Color="{StaticResource SafetyOverlayFillColorSecondary}" />
      <SolidColorBrush x:Key="SafetyOverlayStrokeColorDefaultBrush" Color="{StaticResource SafetyOverlayStrokeColorDefault}" />
      <SolidColorBrush x:Key="SafetyOverlayShadeColorDefaultBrush" Color="{StaticResource SafetyOverlayShadeColorDefault}" />
      <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SystemAccentColor}" />
      <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="{StaticResource SystemAccentColorLight1}" />
      <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="{StaticResource SystemAccentColorLight2}" />
      <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="{StaticResource SystemAccentColorLight3}" />
      <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="{StaticResource SystemAccentColorDark1}" />
      <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="{StaticResource SystemAccentColorDark2}" />
      <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="{StaticResource SystemAccentColorDark3}" />

      <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{StaticResource ControlStrokeColorDefault}" Offset="0" />
        <GradientStop Color="{StaticResource ControlStrokeColorDefault}" Offset="0.92" />
        <GradientStop Color="{StaticResource ControlStrokeColorSecondary}" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentControlElevationBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{StaticResource ControlStrokeColorOnAccentDefault}" Offset="0" />
        <GradientStop Color="{StaticResource ControlStrokeColorOnAccentDefault}" Offset="0.92" />
        <GradientStop Color="{StaticResource ControlStrokeColorOnAccentSecondary}" Offset="1" />
      </LinearGradientBrush>
      <!-- 输入框底边比普通控件更明显：rest 就用 control-strong-stroke -->
      <LinearGradientBrush x:Key="TextControlElevationBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{StaticResource ControlStrokeColorDefault}" Offset="0" />
        <GradientStop Color="{StaticResource ControlStrokeColorDefault}" Offset="0.92" />
        <GradientStop Color="{StaticResource ControlStrongStrokeColorDefault}" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
