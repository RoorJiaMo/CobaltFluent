<!-- AlarmBanner —— 第 7 组，报警横幅。
     安全色不跟随主题：Alarm / Fault 用 SafetyRedBrush，不是 SystemFillColorCriticalBrush
     （后者深色主题下是浅粉 #FF99A4，对需要立即处置的级别是错的）。 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fc="using:Cobalt.Fluent.Controls">

  <ControlTheme x:Key="{x:Type fc:AlarmBanner}" TargetType="fc:AlarmBanner">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate TargetType="fc:AlarmBanner">
        <Panel>
          <Border x:Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" >

              <fc:SymbolIcon x:Name="PART_Glyph"
                             Grid.Column="0"
                             Symbol="{TemplateBinding Glyph}"
                             FontSize="16"
                             Margin="0,2,12,0"
                             VerticalAlignment="Top"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="PART_Title"
                           Text="{TemplateBinding Title}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{TemplateBinding Foreground}" />
                <TextBlock x:Name="PART_Detail"
                           Text="{TemplateBinding Detail}"
                           FontSize="{DynamicResource CaptionFontSize}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{TemplateBinding Detail,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock x:Name="PART_More"
                           FontSize="{DynamicResource CaptionFontSize}"
                           TextDecorations="Underline"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{TemplateBinding AdditionalText}"
                           IsVisible="{TemplateBinding AdditionalText,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <TextBlock x:Name="PART_Time"
                         Grid.Column="2"
                         Margin="16,2,0,0"
                         VerticalAlignment="Top"
                         FontSize="{DynamicResource CaptionFontSize}"
                         FontFeatures="{StaticResource TabularNumbers}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="{TemplateBinding TimeText}"
                         IsVisible="{TemplateBinding TimeText,
                                     Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <StackPanel Grid.Column="3"
                          Orientation="Horizontal"
                          Spacing="8"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center">
                <ContentPresenter Content="{TemplateBinding Actions}"
                                  ContentTemplate="{TemplateBinding ActionsTemplate}"
                                  VerticalAlignment="Center" />
                <Button x:Name="PART_Details"
                        Content="{TemplateBinding DetailsContent}"
                        IsVisible="{TemplateBinding DetailsCommand,
                                    Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- 确认后按钮消失，但横幅留着——报警条件还在 -->
                <Button x:Name="PART_Acknowledge"
                        Content="{TemplateBinding AcknowledgeContent}"
                        IsVisible="{TemplateBinding IsAcknowledged,
                                    Converter={x:Static BoolConverters.Not}}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- 关掉呼吸时用这圈安全黄描边补强。不补的话降级后 Alarm 和 Warning 长得一样。
               **必须排在 PART_Root 之后。** Panel 里后面的子元素画在上面，而
               PART_Root 带不透明背景（:alarm 下是 SafetyRed 实底），排在前面时
               这 2px 黄环会被整个盖住——伪类和 IsVisible 全是对的，渲染出来却没有环，
               只看伪类的测试一路绿灯。只描边不填充，IsHitTestVisible=False
               以免挡住确认与详情按钮的命中测试。 -->
          <Border x:Name="PART_ReducedMotionRing"
                  BorderBrush="{DynamicResource SafetyYellowBrush}"
                  BorderThickness="2"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:warning">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
      <Style Selector="^ /template/ fc|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
      </Style>
    </Style>

    <!-- Alarm / Fault：安全红实底 + 白字。不跟随主题。 -->
    <Style Selector="^:alarm, ^:fault">
      <Setter Property="Background" Value="{DynamicResource SafetyRedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnSafetyFillColorPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />

      <Style Selector="^ /template/ fc|SymbolIcon#PART_Glyph">
        <Setter Property="Foreground" Value="{DynamicResource TextOnSafetyFillColorPrimaryBrush}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_Detail">
        <Setter Property="Foreground" Value="{DynamicResource TextOnSafetyFillColorPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.85" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_Time">
        <Setter Property="Foreground" Value="{DynamicResource TextOnSafetyFillColorPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.85" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_More">
        <Setter Property="Foreground" Value="{DynamicResource TextOnSafetyFillColorPrimaryBrush}" />
      </Style>

      <!-- 红底上的按钮要可读：白色半透明底 + 白字 -->
      <Style Selector="^ Button">
        <Setter Property="Background" Value="{DynamicResource SafetyOverlayFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnSafetyFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SafetyOverlayStrokeColorDefaultBrush}" />
      </Style>
      <Style Selector="^ Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SafetyOverlayFillColorSecondaryBrush}" />
      </Style>
    </Style>

    <!-- Fault：黄色左边条。ISO 13850 的红黄配。 -->
    <Style Selector="^:fault /template/ Border#PART_Root">
      <Setter Property="BorderBrush" Value="{DynamicResource SafetyYellowBrush}" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
    </Style>

    <!-- 呼吸：1.5s，opacity 1↔.62。不是闪烁——高频闪烁引发疲劳，且有光敏性癫痫风险。 -->
    <Style Selector="^:breathing /template/ Border#PART_Root">
      <Style.Animations>
        <Animation Duration="0:0:1.5" IterationCount="Infinite" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.62" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- 关了呼吸的 Alarm 必须补黄环，否则和 Warning 分不出来 -->
    <Style Selector="^:alarm[IsBreathingEnabled=False] /template/ Border#PART_ReducedMotionRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- 已确认也停呼吸，同样要补 -->
    <Style Selector="^:alarm:acknowledged /template/ Border#PART_ReducedMotionRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
