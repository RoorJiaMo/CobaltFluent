<!-- SplitButton / ToggleSplitButton / DropDownButton。

     两半相接处「不圆角、不双线」：
       左半 CornerRadius 4,0,0,4 + BorderThickness 1,1,0,1（border-right-width:0）
       右半 CornerRadius 0,4,4,0 + BorderThickness 0,1,1,1（border-left-width:0）
       中间一条 1px 分隔线，上下各内缩 4
     圆角在这里写死，**不要绑 ControlCornerRadius** —— 绑了的话改全局圆角时接缝会裂开。

     变体 Classes：accent。 -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fc="using:Cobalt.Fluent.Controls">

  <!-- SplitButton 左右两半共用的壳。这里只出模板和过渡，颜色一律不给：
       状态色由外层 SplitButton 的 ControlTheme 用 /template/ Button 选择器统一发下来，
       .accent / :checked 这类只存在于外层的变体才能一处写完，不必给每个变体再复制一份组件主题。 -->
  <ControlTheme x:Key="SplitButtonComponent" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          RecognizesAccessKey="True" />
      </ControlTemplate>
    </Setter>
    <!-- 只过渡颜色，不过渡位移 -->
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.083" />
      </Transitions>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type SplitButton}" TargetType="SplitButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Focusable" Value="True" />
    <!-- 聚焦框套在整个控件外面，两个内部按钮不参与 Tab -->
    <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="SplitButton">
        <Grid ColumnDefinitions="*,Auto,Auto">

          <Button x:Name="PART_PrimaryButton"
                  Grid.Column="0"
                  Theme="{StaticResource SplitButtonComponent}"
                  MinWidth="{DynamicResource ControlMinWidth}"
                  CornerRadius="4,0,0,4"
                  BorderThickness="1,1,0,1"
                  Padding="{TemplateBinding Padding}"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  Command="{TemplateBinding Command}"
                  CommandParameter="{TemplateBinding CommandParameter}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  Focusable="False"
                  IsTabStop="False" />

          <!-- 分隔线：1px 宽，上下各内缩 4，接缝处只有这一条线（两半各自缺一条边） -->
          <Rectangle x:Name="PART_Separator"
                     Grid.Column="1"
                     Width="1"
                     Margin="0,4"
                     VerticalAlignment="Stretch"
                     Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

          <Button x:Name="PART_SecondaryButton"
                  Grid.Column="2"
                  Theme="{StaticResource SplitButtonComponent}"
                  Width="30"
                  MinWidth="30"
                  Padding="0"
                  CornerRadius="0,4,4,0"
                  BorderThickness="0,1,1,1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Focusable="False"
                  IsTabStop="False">
            <!-- ChevronDown。10px，颜色不写死，跟随所在按钮的 Foreground 走状态。
                 画矢量不用图标字体：嵌入式 Linux 上没有 Segoe Fluent Icons。 -->
            <fc:SymbolIcon Symbol="ChevronDown"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Button>
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- 两半的状态各算各的：只有指针底下那一半变色。颜色对两半是同一套，所以用 Button 通选。 -->
    <Style Selector="^ /template/ Button">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <!-- 底边深一档，靠渐变描边实现。这是 Win11 按钮的签名细节。 -->
      <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
    </Style>

    <Style Selector="^ /template/ Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>

    <!-- 按下时底边渐变拍平成实色 = 视觉上「陷进去」 -->
    <Style Selector="^ /template/ Button:pressed">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <Style Selector="^ /template/ Button:disabled">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- 展开中的次键保持按下相：菜单开着的时候要看得出来是它开的 -->
    <Style Selector="^:flyout-open /template/ Button#PART_SecondaryButton">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- accent —— 一屏只能有一个 -->
    <Style Selector="^.accent">
      <Style Selector="^ /template/ Button">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
      </Style>
      <Style Selector="^ /template/ Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^ /template/ Button:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" />
      </Style>
      <Style Selector="^ /template/ Button:disabled">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <!-- 分隔线在 accent 底色上换成 on-accent 那一档，否则深底上看不见 -->
      <Style Selector="^ /template/ Rectangle#PART_Separator">
        <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorOnAccentSecondaryBrush}" />
      </Style>
      <Style Selector="^:flyout-open /template/ Button#PART_SecondaryButton">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" />
      </Style>
    </Style>

    <!-- :checked —— 只有 ToggleSplitButton 会进这一态（和 ToggleButton 的选中相一致：
         整只走 accent 填充）。写在 SplitButton 这份主题里而不是单开一份 ToggleSplitButton 主题：
         Avalonia 的 ToggleSplitButton.StyleKeyOverride 就是 typeof(SplitButton)，
         查不到 x:Key="{x:Type ToggleSplitButton}"。普通 SplitButton 永远不带 :checked，互不干扰。 -->
    <Style Selector="^:checked">
      <Style Selector="^ /template/ Button">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
      </Style>
      <Style Selector="^ /template/ Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^ /template/ Button:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" />
      </Style>
      <Style Selector="^ /template/ Button:disabled">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_Separator">
        <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorOnAccentSecondaryBrush}" />
      </Style>
      <Style Selector="^:flyout-open /template/ Button#PART_SecondaryButton">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" />
      </Style>
    </Style>
  </ControlTheme>

  <!-- ToggleSplitButton 的外观全部写在上面的 SplitButton ControlTheme 里（含 :checked）。
       原因：Avalonia 的 ToggleSplitButton.StyleKeyOverride 返回 typeof(SplitButton)，
       控件主题是按 StyleKey 查的，**不会**回退到基类，
       所以 x:Key="{x:Type ToggleSplitButton}" 这个键永远查不到，写在里面的样式是死的。
       这里只留一个同义键，万一将来 StyleKey 改回自身也能接上。 -->
  <ControlTheme x:Key="{x:Type ToggleSplitButton}" TargetType="ToggleSplitButton"
                BasedOn="{StaticResource {x:Type SplitButton}}" />

  <!-- DropDownButton —— 就是一只 Button 加一个 chevron，
       所以外观、状态、变体全部照 Button 走，只是模板里多一列放 10px 的箭头。
       内容与箭头之间 8（space-2），左右各 11 由 Padding 出。 -->
  <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource ControlMinWidth}" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="DropDownButton">
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
            <!-- ChevronDown 10px / text-secondary，与内容间距 8 -->
            <fc:SymbolIcon x:Name="PART_Chevron"
                       Grid.Column="1"
                       Symbol="ChevronDown"
                       FontSize="10"
                       Margin="8,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.083" />
      </Transitions>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>

    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- 菜单开着时保持按下相 -->
    <Style Selector="^:flyout-open">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
      <!-- 禁用时 chevron 跟着走 text-disabled -->
      <Style Selector="^ /template/ fc|SymbolIcon#PART_Chevron">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      </Style>
    </Style>

    <!-- accent —— 一屏只能有一个 -->
    <Style Selector="^.accent">
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />

      <!-- 箭头也得换到 on-accent 那一档，不然深底上的 text-secondary 读不出来 -->
      <Style Selector="^ /template/ fc|SymbolIcon#PART_Chevron">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" />
      </Style>
      <Style Selector="^:flyout-open">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorOnAccentDefaultBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style Selector="^ /template/ fc|SymbolIcon#PART_Chevron">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
        </Style>
      </Style>
    </Style>

    <!-- subtle —— 无底色，工具栏用 -->
    <Style Selector="^.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^:flyout-open">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
      </Style>
    </Style>
  </ControlTheme>

</ResourceDictionary>
